Функция PasswordVerifyPost(Запрос)

    Попытка
        Если СтрДлина(Запрос.ПолучитьТелоКакСтроку()) > 4096 Тогда
            Возврат JSONОшибка(413, "invalid_request", "Некорректный запрос.");
        КонецЕсли;

        Данные = ПрочитатьТело(Запрос);

        Телефон = Неопределено;
        Пароль = Неопределено;

        Если НЕ Данные.Свойство("phone", Телефон)
            Или НЕ Данные.Свойство("password", Пароль) Тогда
            Возврат JSONОтвет(200, Новый Структура("authenticated", Ложь));
        КонецЕсли;

        Телефон = НормализоватьТелефон(Телефон);

        Если ТипЗнч(Пароль) <> Тип("Строка") Тогда
            Возврат JSONОтвет(200, Новый Структура("authenticated", Ложь));
        КонецЕсли;

        Если ПустаяСтрока(Телефон)
            Или СтрДлина(Пароль) = 0
            Или СтрДлина(Пароль) > 128 Тогда
            Возврат JSONОтвет(200, Новый Структура("authenticated", Ложь));
        КонецЕсли;

        Ссылка = НайтиПоТелефону(Телефон);

        Если Ссылка.Пустая() Тогда
            Возврат JSONОтвет(200, Новый Структура("authenticated", Ложь));
        КонецЕсли;

        Если НЕ ПроверитьПарольПриложения(Ссылка, Пароль) Тогда
            Возврат JSONОтвет(200, Новый Структура("authenticated", Ложь));
        КонецЕсли;

        Роли = ПолучитьРоли(Ссылка);

        Если Роли.Количество() = 0 Тогда
            Возврат JSONОтвет(200, Новый Структура("authenticated", Ложь));
        КонецЕсли;

        ОтветДанные = Новый Структура;
        ОтветДанные.Вставить("authenticated", Истина);
        ОтветДанные.Вставить("onecId",
            Строка(Ссылка.УникальныйИдентификатор()));
        ОтветДанные.Вставить("phone", Телефон);
        ОтветДанные.Вставить("isActive", Истина);
        ОтветДанные.Вставить("roles", Роли);

        Ответ = JSONОтвет(200, ОтветДанные);
        Ответ.Заголовки.Вставить("Cache-Control", "no-store");
        Возврат Ответ;

    Исключение
        Возврат JSONОшибка(500, "verification_failed",
            "Не удалось проверить пароль.");
    КонецПопытки;

КонецФункции

Функция PasswordChangePost(Запрос)

    Попытка
        Если СтрДлина(Запрос.ПолучитьТелоКакСтроку()) > 4096 Тогда
            Возврат JSONОшибка(413, "invalid_request", "Некорректный запрос.");
        КонецЕсли;

        Данные = ПрочитатьТело(Запрос);
        ТелефонВход = Неопределено;
        НативныйИД = Неопределено;
        СтарыйПароль = Неопределено;
        НовыйПароль = Неопределено;

        Если НЕ Данные.Свойство("phone", ТелефонВход)
            Или НЕ Данные.Свойство("onecId", НативныйИД)
            Или НЕ Данные.Свойство("currentPassword", СтарыйПароль)
            Или НЕ Данные.Свойство("newPassword", НовыйПароль) Тогда
            Возврат JSONОтвет(200, Новый Структура("changed", Ложь));
        КонецЕсли;

        Телефон = НормализоватьТелефон(ТелефонВход);
        Если ПустаяСтрока(Телефон)
            Или ТипЗнч(НативныйИД) <> Тип("Строка")
            Или ТипЗнч(СтарыйПароль) <> Тип("Строка")
            Или ТипЗнч(НовыйПароль) <> Тип("Строка") Тогда
            Возврат JSONОтвет(200, Новый Структура("changed", Ложь));
        КонецЕсли;

        Если СтрДлина(СтарыйПароль) < 1
            Или СтрДлина(СтарыйПароль) > 128
            Или СтрДлина(НовыйПароль) < 8
            Или СтрДлина(НовыйПароль) > 128 Тогда
            Возврат JSONОтвет(200, Новый Структура("changed", Ложь));
        КонецЕсли;

        Попытка
            ИД = Новый УникальныйИдентификатор(НативныйИД);
        Исключение
            Возврат JSONОтвет(200, Новый Структура("changed", Ложь));
        КонецПопытки;

        Ссылка = НайтиПоТелефону(Телефон);
        Если Ссылка.Пустая()
            Или Ссылка.УникальныйИдентификатор() <> ИД Тогда
            Возврат JSONОтвет(200, Новый Структура("changed", Ложь));
        КонецЕсли;

    Исключение
        Возврат JSONОшибка(400, "invalid_request", "Некорректный запрос.");
    КонецПопытки;

    Попытка
        НачатьТранзакцию();
        Если НЕ ПроверитьПарольПриложения(Ссылка, СтарыйПароль) Тогда
            ОтменитьТранзакцию();
            Возврат JSONОтвет(200, Новый Структура("changed", Ложь));
        КонецЕсли;

        УстановитьПарольПриложения(Ссылка, НовыйПароль);
        ЗафиксироватьТранзакцию();

    Исключение
        ОтменитьТранзакцию();
        ЗаписьЖурналаРегистрации("ServiceCarAPI.СменаПароля",
            УровеньЖурналаРегистрации.Ошибка, , ,
            "Не удалось завершить смену пароля приложения.");
        Возврат JSONОшибка(500, "password_change_failed",
            "Не удалось изменить пароль.");
    КонецПопытки;

    Результат = Новый Структура;
    Результат.Вставить("changed", Истина);
    Результат.Вставить("phone", Телефон);
    Результат.Вставить("onecId", Строка(Ссылка.УникальныйИдентификатор()));
    Ответ = JSONОтвет(200, Результат);
    Ответ.Заголовки.Вставить("Cache-Control", "no-store");
    Возврат Ответ;

КонецФункции

Функция PasswordSetupPost(Запрос)
    Попытка
        Если СтрДлина(Запрос.ПолучитьТелоКакСтроку()) > 4096 Тогда
            Возврат JSONОшибка(413, "invalid_request", "Некорректный запрос.");
        КонецЕсли;

        Данные = ПрочитатьТело(Запрос);
        ТелефонВход = Неопределено;
        НативныйИД = Неопределено;
        ВнешнийИД = Неопределено;
        НовыйПароль = Неопределено;
        Если НЕ Данные.Свойство("phone", ТелефонВход)
            Или НЕ Данные.Свойство("onecId", НативныйИД)
            Или НЕ Данные.Свойство("externalId", ВнешнийИД)
            Или НЕ Данные.Свойство("newPassword", НовыйПароль) Тогда
            Возврат JSONОшибка(400, "invalid_request", "Не хватает полей.");
        КонецЕсли;

        Телефон = НормализоватьТелефон(ТелефонВход);
        Если ПустаяСтрока(Телефон)
            Или ТипЗнч(НативныйИД) <> Тип("Строка")
            Или ТипЗнч(ВнешнийИД) <> Тип("Строка")
            Или ТипЗнч(НовыйПароль) <> Тип("Строка")
            Или ПустаяСтрока(ВнешнийИД)
            Или СтрДлина(ВнешнийИД) > 255
            Или СтрДлина(НовыйПароль) < 8
            Или СтрДлина(НовыйПароль) > 128 Тогда
            Возврат JSONОшибка(400, "invalid_request", "Некорректные поля.");
        КонецЕсли;

        Попытка
            ИД = Новый УникальныйИдентификатор(НативныйИД);
        Исключение
            Возврат JSONОшибка(400, "invalid_identity", "Некорректный ID.");
        КонецПопытки;
        Ссылка = НайтиПоТелефону(Телефон);
        Если Ссылка.Пустая() Или Ссылка.УникальныйИдентификатор() <> ИД Тогда
            Возврат JSONОшибка(409, "identity_mismatch", "Пользователь не совпадает.");
        КонецЕсли;
        Объект = Ссылка.ПолучитьОбъект();
        Если Объект = Неопределено
            Или Объект.ПометкаУдаления
            Или НЕ Объект.Активен
            Или Объект.ИдентификаторВнешний <> ВнешнийИД Тогда
            Возврат JSONОшибка(409, "identity_mismatch", "Пользователь не совпадает.");
        КонецЕсли;
    Исключение
        Возврат JSONОшибка(400, "invalid_request", "Некорректный запрос.");
    КонецПопытки;

    Попытка
        НачатьТранзакцию();
        Если ЕстьПарольПриложения(Ссылка) Тогда
            ОтменитьТранзакцию();
            Возврат JSONОшибка(409, "password_exists",
                "Пароль уже существует. Требуется смена с текущим паролем.");
        КонецЕсли;
        УстановитьПарольПриложения(Ссылка, НовыйПароль);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ЗаписьЖурналаРегистрации("ServiceCarAPI.УстановкаПароля",
            УровеньЖурналаРегистрации.Ошибка, , ,
            "Не удалось установить первый пароль приложения.");
        Возврат JSONОшибка(500, "password_setup_failed",
            "Не удалось установить пароль.");
    КонецПопытки;

    Результат = Новый Структура;
    Результат.Вставить("created", Истина);
    Результат.Вставить("phone", Телефон);
    Результат.Вставить("onecId", Строка(Ссылка.УникальныйИдентификатор()));
    Ответ = JSONОтвет(200, Результат);
    Ответ.Заголовки.Вставить("Cache-Control", "no-store");
    Возврат Ответ;
КонецФункции

// MAX ЛОГИКА: внутренние HTTP-вызовы из Django через ServiceCarAPI.
Функция MAXОшибка(Статус, Код, Сообщение)
    Возврат JSONОтвет(Статус, Новый Структура("code,message", Код, Сообщение));
КонецФункции

Функция MAXПрочитатьЗапрос(Запрос)
    Текст = Запрос.ПолучитьТелоКакСтроку();
    Если СтрДлина(Текст) > 8192 Тогда
        ВызватьИсключение "Слишком большой запрос.";
    КонецЕсли;
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Текст);
    Данные = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Если ТипЗнч(Данные) <> Тип("Структура") Тогда
        ВызватьИсключение "Ожидается объект JSON.";
    КонецЕсли;
    Возврат Данные;
КонецФункции

Функция MAXПоле(Данные, Имя, Максимум, Обязательно = Истина)
    Значение = Неопределено;
    Если НЕ Данные.Свойство(Имя, Значение) Тогда
        Если Обязательно Тогда
            ВызватьИсключение "Отсутствует поле " + Имя;
        КонецЕсли;
        Возврат "";
    КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Строка")
        Или СтрДлина(Значение) > Максимум Тогда
        ВызватьИсключение "Некорректное поле " + Имя;
    КонецЕсли;
    Значение = СокрЛП(Значение);
    Если Обязательно И ПустаяСтрока(Значение) Тогда
        ВызватьИсключение "Пустое поле " + Имя;
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция MAXНайтиПользователяПоТелефону(Телефон)
    Возврат Справочники.ПользователиПриложения.НайтиПоРеквизиту("Телефон", Телефон);
КонецФункции

Функция MAXПрофиль(Ссылка)
    Объект = Ссылка.ПолучитьОбъект();
    Данные = Новый Структура;
    Данные.Вставить("onecId", Строка(Ссылка.УникальныйИдентификатор()));
    Данные.Вставить("externalId", Объект.ИдентификаторВнешний);
    Данные.Вставить("phone", Объект.Телефон);
    Данные.Вставить("messengerUserId", Объект.ИдентификаторMAX);
    Данные.Вставить("firstName", Объект.Имя);
    Данные.Вставить("lastName", Объект.Фамилия);
    Данные.Вставить("isActive", Объект.Активен И НЕ Объект.ПометкаУдаления);
    Данные.Вставить("roles", ПолучитьРоли(Ссылка));
    Возврат Данные;
КонецФункции

Функция MAXДатаИзСтроки(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) <> 14 Тогда
        ВызватьИсключение "Некорректная дата кода.";
    КонецЕсли;
    Возврат Дата(Число(Лев(Значение, 4)), Число(Сред(Значение, 5, 2)),
        Число(Сред(Значение, 7, 2)), Число(Сред(Значение, 9, 2)),
        Число(Сред(Значение, 11, 2)), Число(Сред(Значение, 13, 2)));
КонецФункции

Функция MAXСостояниеКода(Ссылка)
    Набор = РегистрыСведений.КодыАвторизацииMAX.СоздатьНаборЗаписей();
    Набор.Отбор.Пользователь.Установить(Ссылка);
    Набор.Прочитать();
    Если Набор.Количество() = 0 Тогда
        Возврат Неопределено;
    КонецЕсли;
    Для Каждого Запись Из Набор Цикл
        Чтение = Новый ЧтениеJSON;
        Чтение.УстановитьСтроку(Запись.Состояние);
        Данные = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();
        Возврат Данные;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

Процедура MAXЗаписатьСостояние(Ссылка, Состояние)
    Набор = РегистрыСведений.КодыАвторизацииMAX.СоздатьНаборЗаписей();
    Набор.Отбор.Пользователь.Установить(Ссылка);
    Если Состояние <> Неопределено Тогда
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, Состояние);
        Сериализация = ЗаписьJSON.Закрыть();
        Если СтрДлина(Сериализация) > 1024 Тогда
            ВызватьИсключение "Слишком длинное состояние кода.";
        КонецЕсли;
        Запись = Набор.Добавить();
        Запись.Пользователь = Ссылка;
        Запись.Состояние = Сериализация;
    КонецЕсли;
    Набор.Записать(Истина);
КонецПроцедуры

Процедура MAXЗаблокироватьПользователей()
    Блокировка = Новый БлокировкаДанных;
    Блокировка.Добавить("Справочник.ПользователиПриложения");
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура MAXЗаблокироватьКоды()
    Блокировка = Новый БлокировкаДанных;
    Блокировка.Добавить("РегистрСведений.КодыАвторизацииMAX");
    Блокировка.Заблокировать();
КонецПроцедуры

Функция MAXResolvePost(Запрос)
    Попытка
        Данные = MAXПрочитатьЗапрос(Запрос);
        MAXID = MAXПоле(Данные, "messengerUserId", 255);
        Если СтрДлина(MAXID) > 20 Тогда
            Возврат MAXОшибка(400, "invalid_max_id", "Некорректный ID MAX.");
        КонецЕсли;
        Для Н = 1 По СтрДлина(MAXID) Цикл
            Если Найти("0123456789", Сред(MAXID, Н, 1)) = 0 Тогда
                Возврат MAXОшибка(400, "invalid_max_id", "Некорректный ID MAX.");
            КонецЕсли;
        КонецЦикла;
        ТелефонВход = MAXПоле(Данные, "phone", 20, Ложь);
        Телефон = "";
        Если НЕ ПустаяСтрока(ТелефонВход) Тогда
            Телефон = НормализоватьТелефон(ТелефонВход);
            Если ПустаяСтрока(Телефон) Тогда
                Возврат MAXОшибка(400, "invalid_phone", "Некорректный номер телефона.");
            КонецЕсли;
        КонецЕсли;
        ВнешнийID = MAXПоле(Данные, "externalId", 36, Ложь);
        Имя = MAXПоле(Данные, "firstName", 150, Ложь);
        Фамилия = MAXПоле(Данные, "lastName", 150, Ложь);
        Если НЕ ПустаяСтрока(Телефон) Тогда
            Если ПустаяСтрока(ВнешнийID) Тогда
                Возврат MAXОшибка(400, "external_id_required", "Требуется ID Django.");
            КонецЕсли;
            Попытка
                UUID = Новый УникальныйИдентификатор(ВнешнийID);
            Исключение
                Возврат MAXОшибка(400, "invalid_external_id", "Некорректный ID Django.");
            КонецПопытки;
        КонецЕсли;
    Исключение
        Возврат MAXОшибка(400, "invalid_request", "Некорректные данные MAX.");
    КонецПопытки;

    Попытка
        НачатьТранзакцию();
        MAXЗаблокироватьПользователей();
        ПоMAX = Справочники.ПользователиПриложения.НайтиПоРеквизиту("ИдентификаторMAX", MAXID);
        Если ПустаяСтрока(Телефон) Тогда
            Если ПоMAX.Пустая() Тогда
                ОтменитьТранзакцию();
                Возврат JSONОтвет(200, Новый Структура("status", "contact_required"));
            КонецЕсли;
            Профиль = MAXПрофиль(ПоMAX);
            ОтменитьТранзакцию();
            Если НЕ Профиль.isActive Тогда
                Возврат MAXОшибка(401, "user_inactive", "Пользователь неактивен.");
            КонецЕсли;
            Возврат JSONОтвет(200, Новый Структура("status,user", "ok", Профиль));
        КонецЕсли;

        ПоТелефону = MAXНайтиПользователяПоТелефону(Телефон);
        ПоВнешнемуID = Справочники.ПользователиПриложения.НайтиПоРеквизиту(
            "ИдентификаторВнешний", ВнешнийID);
        Конфликт = Ложь;
        Если НЕ ПоMAX.Пустая() Тогда
            Если ПоMAX.Телефон <> Телефон Тогда
                Конфликт = Истина;
            ИначеЕсли НЕ ПоТелефону.Пустая() И ПоMAX <> ПоТелефону Тогда
                Конфликт = Истина;
            КонецЕсли;
        КонецЕсли;
        Если НЕ ПоВнешнемуID.Пустая() Тогда
            Если ПоТелефону.Пустая() Тогда
                Конфликт = Истина;
            ИначеЕсли ПоВнешнемуID <> ПоТелефону Тогда
                Конфликт = Истина;
            КонецЕсли;
        КонецЕсли;
        Если Конфликт Тогда
            ОтменитьТранзакцию();
            Возврат MAXОшибка(409, "max_account_conflict",
                "Аккаунт MAX или телефон связан с другим пользователем.");
        КонецЕсли;
        Если ПоТелефону.Пустая() Тогда
            Объект = Справочники.ПользователиПриложения.СоздатьЭлемент();
            Объект.Телефон = Телефон;
            Объект.ИдентификаторВнешний = ВнешнийID;
            Объект.ИдентификаторMAX = MAXID;
            Объект.Имя = Имя;
            Объект.Фамилия = Фамилия;
            Объект.Активен = Истина;
            Объект.Записать();
            Ссылка = Объект.Ссылка;
            НаборРолей = РегистрыСведений.РолиПользователей.СоздатьНаборЗаписей();
            НаборРолей.Отбор.Пользователь.Установить(Ссылка);
            РольЗапись = НаборРолей.Добавить();
            РольЗапись.Пользователь = Ссылка;
            РольЗапись.Роль = Перечисления.РолиПользователей.Пользователь;
            НаборРолей.Записать(Истина);
        Иначе
            Ссылка = ПоТелефону;
            Объект = Ссылка.ПолучитьОбъект();
            Если Объект = Неопределено Или Объект.ПометкаУдаления
                Или НЕ Объект.Активен Тогда
                ОтменитьТранзакцию();
                Возврат MAXОшибка(401, "user_inactive", "Пользователь неактивен.");
            КонецЕсли;
            Если (НЕ ПустаяСтрока(Объект.ИдентификаторMAX)
                    И Объект.ИдентификаторMAX <> MAXID)
                Или Объект.ИдентификаторВнешний <> ВнешнийID Тогда
                ОтменитьТранзакцию();
                Возврат MAXОшибка(409, "max_account_conflict",
                    "Аккаунт MAX или телефон связан с другим пользователем.");
            КонецЕсли;
            Объект.ИдентификаторMAX = MAXID;
            Если ПустаяСтрока(Объект.Имя) Тогда Объект.Имя = Имя; КонецЕсли;
            Если ПустаяСтрока(Объект.Фамилия) Тогда Объект.Фамилия = Фамилия; КонецЕсли;
            Объект.Записать();
        КонецЕсли;
        Профиль = MAXПрофиль(Ссылка);
        ЗафиксироватьТранзакцию();
        Ответ = JSONОтвет(200, Новый Структура("status,user", "ok", Профиль));
        Возврат Ответ;
    Исключение
        ОтменитьТранзакцию();
        ЗаписьЖурналаРегистрации("ServiceCarAuth.MAXResolve",
            УровеньЖурналаРегистрации.Ошибка, , , "Не удалось разрешить MAX-аккаунт.");
        Возврат JSONОшибка(500, "max_unavailable", "Не удалось выполнить операцию MAX.");
    КонецПопытки;
КонецФункции

// Ключ хранится в 1С; одноразовый код создаётся и доставляется шлюзом Django.
// Метки времени, лимиты попыток и использование кода проверяет 1С.
Функция MAXCodeIssuePost(Запрос)
    Попытка
        Данные = MAXПрочитатьЗапрос(Запрос);
        Телефон = НормализоватьТелефон(MAXПоле(Данные, "phone", 20));
        Код = MAXПоле(Данные, "code", 6);
        RequestID = MAXПоле(Данные, "requestId", 36);
        Если ПустаяСтрока(Телефон) Или СтрДлина(Код) <> 6 Тогда
            Возврат MAXОшибка(400, "invalid_request", "Некорректный запрос.");
        КонецЕсли;
        Для Н = 1 По 6 Цикл
            Если Найти("0123456789", Сред(Код, Н, 1)) = 0 Тогда
                Возврат MAXОшибка(400, "invalid_request", "Некорректный запрос.");
            КонецЕсли;
        КонецЦикла;
        UUID = Новый УникальныйИдентификатор(RequestID);
    Исключение
        Возврат MAXОшибка(400, "invalid_request", "Некорректный запрос.");
    КонецПопытки;
    Попытка
        НачатьТранзакцию();
        MAXЗаблокироватьКоды();
        Ссылка = MAXНайтиПользователяПоТелефону(Телефон);
        Если Ссылка.Пустая() Тогда
            ОтменитьТранзакцию();
            Возврат MAXОшибка(401, "max_not_available", "Вход через MAX недоступен.");
        КонецЕсли;
        Профиль = MAXПрофиль(Ссылка);
        Если НЕ Профиль.isActive Или ПустаяСтрока(Профиль.messengerUserId) Тогда
            ОтменитьТранзакцию();
            Возврат MAXОшибка(401, "max_not_available", "Вход через MAX недоступен.");
        КонецЕсли;
        Предыдущий = MAXСостояниеКода(Ссылка);
        Сейчас = ТекущаяДата();
        Если Предыдущий <> Неопределено
            И Сейчас < MAXДатаИзСтроки(Предыдущий.createdAt) + 60 Тогда
            ОтменитьТранзакцию();
            Возврат MAXОшибка(429, "max_code_throttled",
                "Повторно запросить код можно через 60 секунд.");
        КонецЕсли;
        Состояние = Новый Структура;
        Состояние.Вставить("hash", ВычислитьСохраняемоеЗначениеПароляПользователя(Код));
        Состояние.Вставить("createdAt", Формат(Сейчас, "ДФ=yyyyMMddHHmmss"));
        Состояние.Вставить("attempts", 0);
        Состояние.Вставить("used", Ложь);
        Состояние.Вставить("requestId", RequestID);
        MAXЗаписатьСостояние(Ссылка, Состояние);
        ЗафиксироватьТранзакцию();
        Возврат JSONОтвет(200, Новый Структура("issued,messengerUserId",
            Истина, Профиль.messengerUserId));
    Исключение
        ОтменитьТранзакцию();
        Возврат JSONОшибка(500, "max_unavailable", "Не удалось выполнить операцию MAX.");
    КонецПопытки;
КонецФункции

Функция MAXCodeCancelPost(Запрос)
    Попытка
        Данные = MAXПрочитатьЗапрос(Запрос);
        Телефон = НормализоватьТелефон(MAXПоле(Данные, "phone", 20));
        RequestID = MAXПоле(Данные, "requestId", 36);
        UUID = Новый УникальныйИдентификатор(RequestID);
        Если ПустаяСтрока(Телефон) Тогда
            Возврат MAXОшибка(400, "invalid_request", "Некорректный запрос.");
        КонецЕсли;
    Исключение
        Возврат MAXОшибка(400, "invalid_request", "Некорректный запрос.");
    КонецПопытки;
    Попытка
        НачатьТранзакцию();
        MAXЗаблокироватьКоды();
        Ссылка = MAXНайтиПользователяПоТелефону(Телефон);
        Если НЕ Ссылка.Пустая() Тогда
            Состояние = MAXСостояниеКода(Ссылка);
            Если Состояние <> Неопределено И Состояние.requestId = RequestID Тогда
                MAXЗаписатьСостояние(Ссылка, Неопределено);
            КонецЕсли;
        КонецЕсли;
        ЗафиксироватьТранзакцию();
        Возврат JSONОтвет(200, Новый Структура("cancelled", Истина));
    Исключение
        ОтменитьТранзакцию();
        Возврат JSONОшибка(500, "max_unavailable", "Не удалось выполнить операцию MAX.");
    КонецПопытки;
КонецФункции

Функция MAXCodeVerifyPost(Запрос)
    Попытка
        Данные = MAXПрочитатьЗапрос(Запрос);
        Телефон = НормализоватьТелефон(MAXПоле(Данные, "phone", 20));
        Код = MAXПоле(Данные, "code", 6);
        Если ПустаяСтрока(Телефон) Или СтрДлина(Код) <> 6 Тогда
            Возврат MAXОшибка(400, "invalid_request", "Некорректный запрос.");
        КонецЕсли;
        Для Н = 1 По 6 Цикл
            Если Найти("0123456789", Сред(Код, Н, 1)) = 0 Тогда
                Возврат MAXОшибка(400, "invalid_request", "Некорректный запрос.");
            КонецЕсли;
        КонецЦикла;
    Исключение
        Возврат MAXОшибка(400, "invalid_request", "Некорректный запрос.");
    КонецПопытки;
    Попытка
        НачатьТранзакцию();
        MAXЗаблокироватьКоды();
        Ссылка = MAXНайтиПользователяПоТелефону(Телефон);
        Если Ссылка.Пустая() Тогда
            ОтменитьТранзакцию();
            Возврат JSONОтвет(200, Новый Структура("authenticated,reason", Ложь, "invalid"));
        КонецЕсли;
        Профиль = MAXПрофиль(Ссылка);
        Если НЕ Профиль.isActive Или ПустаяСтрока(Профиль.messengerUserId) Тогда
            ОтменитьТранзакцию();
            Возврат JSONОтвет(200, Новый Структура("authenticated,reason", Ложь, "invalid"));
        КонецЕсли;
        Состояние = MAXСостояниеКода(Ссылка);
        Если Состояние = Неопределено Тогда
            ОтменитьТранзакцию();
            Возврат JSONОтвет(200, Новый Структура("authenticated,reason", Ложь, "invalid"));
        КонецЕсли;
        Причина = "";
        Если Состояние.used Тогда
            Причина = "used";
        ИначеЕсли ТекущаяДата() >= MAXДатаИзСтроки(Состояние.createdAt) + 300 Тогда
            Причина = "expired";
        ИначеЕсли Состояние.attempts >= 5 Тогда
            Причина = "attempts";
        ИначеЕсли НЕ ПроверитьСоответствиеПароляПользователяСохраняемомуЗначению(
                Код, Состояние.hash) Тогда
            Состояние.attempts = Состояние.attempts + 1;
            MAXЗаписатьСостояние(Ссылка, Состояние);
            Причина = "invalid";
        Иначе
            Состояние.used = Истина;
            MAXЗаписатьСостояние(Ссылка, Состояние);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
        Если НЕ ПустаяСтрока(Причина) Тогда
            Возврат JSONОтвет(200, Новый Структура("authenticated,reason", Ложь, Причина));
        КонецЕсли;
        Возврат JSONОтвет(200, Новый Структура("authenticated,user", Истина, Профиль));
    Исключение
        ОтменитьТранзакцию();
        Возврат JSONОшибка(500, "max_unavailable", "Не удалось выполнить операцию MAX.");
    КонецПопытки;
КонецФункции