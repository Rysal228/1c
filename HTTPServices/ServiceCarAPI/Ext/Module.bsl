Функция JSONОтвет(КодСостояния, Тело)
    Ответ = Новый HTTPСервисОтвет(КодСостояния);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Тело);
    Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8);
    Возврат Ответ;
КонецФункции

Функция JSONОшибка(КодСостояния, Код, Сообщение)
    Данные = Новый Структура;
    Данные.Вставить("code", Код);
    Данные.Вставить("message", Сообщение);
    Возврат JSONОтвет(КодСостояния, Данные);
КонецФункции

Функция ПрочитатьТело(Запрос)
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
    Данные = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Если ТипЗнч(Данные) <> Тип("Структура") Тогда
        ВызватьИсключение "Ожидается JSON-объект.";
    КонецЕсли;
    Возврат Данные;
КонецФункции

Функция ВычислитьХешПароляПриложения(НовыйПароль)
    Если ТипЗнч(НовыйПароль) <> Тип("Строка") Тогда
        ВызватьИсключение "Некорректный пароль.";
    КонецЕсли;
    Если СтрДлина(НовыйПароль) < 8 Или СтрДлина(НовыйПароль) > 128 Тогда
        ВызватьИсключение "Длина пароля должна быть от 8 до 128 символов.";
    КонецЕсли;

    // Встроенная функция создаёт сохраняемое представление с солью
    // согласно выбранному алгоритму хеширования паролей ИБ.
    Возврат ВычислитьСохраняемоеЗначениеПароляПользователя(НовыйПароль);
КонецФункции

Процедура УстановитьПарольПриложения(СсылкаПользователя, НовыйПароль)
    Если СсылкаПользователя.Пустая() Тогда
        ВызватьИсключение "Не указан пользователь.";
    КонецЕсли;
    ОбъектПользователя = СсылкаПользователя.ПолучитьОбъект();
    Если ОбъектПользователя = Неопределено Или ОбъектПользователя.ПометкаУдаления Тогда
        ВызватьИсключение "Пользователь не существует.";
    КонецЕсли;

    ЗначениеПароля = ВычислитьХешПароляПриложения(НовыйПароль);
	
	Если СтрДлина(ЗначениеПароля) > 1024 Тогда
		ВызватьИсключение "Формат хеша пароля превышает длину ресурса регистра.";
	КонецЕсли;
	
    Набор = РегистрыСведений.ПаролиПользователейПриложения.СоздатьНаборЗаписей();
    Набор.Отбор.Пользователь.Установить(СсылкаПользователя);
    Набор.Прочитать();
    Набор.Очистить();
    Запись = Набор.Добавить();
    Запись.Пользователь = СсылкаПользователя;
    Запись.СохраняемоеЗначение = ЗначениеПароля;
    Набор.Записать();
КонецПроцедуры

Функция ПроверитьПарольПриложения(СсылкаПользователя, Пароль)
    Если ТипЗнч(Пароль) <> Тип("Строка") Тогда
        Возврат Ложь;
    КонецЕсли;
    Если СсылкаПользователя.Пустая() Тогда
        Возврат Ложь;
    КонецЕсли;
    ОбъектПользователя = СсылкаПользователя.ПолучитьОбъект();
    Если ОбъектПользователя = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;
    Если ОбъектПользователя.ПометкаУдаления Или НЕ ОбъектПользователя.Активен Тогда
        Возврат Ложь;
    КонецЕсли;

    Набор = РегистрыСведений.ПаролиПользователейПриложения.СоздатьНаборЗаписей();
    Набор.Отбор.Пользователь.Установить(СсылкаПользователя);
    Набор.Прочитать();
    Если Набор.Количество() <> 1 Тогда
        Возврат Ложь;
    КонецЕсли;
    Для Каждого Запись Из Набор Цикл
        Если ПустаяСтрока(Запись.СохраняемоеЗначение) Тогда
            Возврат Ложь;
        КонецЕсли;
        Возврат ПроверитьСоответствиеПароляПользователяСохраняемомуЗначению(
            Пароль, Запись.СохраняемоеЗначение);
    КонецЦикла;
    Возврат Ложь;
КонецФункции

Функция НормализоватьТелефон(ИсходноеЗначение)
    Если ТипЗнч(ИсходноеЗначение) <> Тип("Строка") Тогда
        Возврат "";
    КонецЕсли;

    Телефон = СокрЛП(ИсходноеЗначение);
    Если Лев(Телефон, 1) = "+" Тогда
        Телефон = Сред(Телефон, 2);
    КонецЕсли;

    // Формат действующего приложения: 7XXXXXXXXXX.
    Если СтрДлина(Телефон) <> 11 Или Лев(Телефон, 1) <> "7" Тогда
        Возврат "";
    КонецЕсли;

    Для Позиция = 1 По 11 Цикл
        Если Найти("0123456789", Сред(Телефон, Позиция, 1)) = 0 Тогда
            Возврат "";
        КонецЕсли;
    КонецЦикла;

    Возврат Телефон;
КонецФункции

Функция НайтиПоТелефону(Телефон)
    // На переходе поддерживаем старые элементы с автонумерованным кодом.
    Ссылка = Справочники.ПользователиПриложения.НайтиПоКоду(Телефон);
    Если Ссылка.Пустая() Тогда
        Ссылка = Справочники.ПользователиПриложения.НайтиПоРеквизиту("Телефон", Телефон);
    КонецЕсли;
    Возврат Ссылка;
КонецФункции

Функция РольПоКоду(Код)
    Если Код = "user" Тогда
        Возврат Перечисления.РолиПользователей.Пользователь;
    ИначеЕсли Код = "mechanic" Тогда
        Возврат Перечисления.РолиПользователей.Специалист;
    ИначеЕсли Код = "admin" Тогда
        // ВАЖНО: проверь смысл соответствия admin ↔ Менеджер.
        Возврат Перечисления.РолиПользователей.Менеджер;
    КонецЕсли;
    Возврат Неопределено;
КонецФункции

Функция КодРоли(Роль)
    Если Роль = Перечисления.РолиПользователей.Пользователь Тогда
        Возврат "user";
    ИначеЕсли Роль = Перечисления.РолиПользователей.Специалист Тогда
        Возврат "mechanic";
    ИначеЕсли Роль = Перечисления.РолиПользователей.Менеджер Тогда
        Возврат "admin";
    КонецЕсли;
    Возврат "";
КонецФункции

Функция ПроверитьРоли(РолиJSON)
    Если ТипЗнч(РолиJSON) <> Тип("Массив") Или РолиJSON.Количество() = 0 Тогда
        ВызватьИсключение "Поле roles должно быть непустым массивом.";
    КонецЕсли;

    Роли = Новый Массив;
    Для Каждого Код Из РолиJSON Цикл
        Если ТипЗнч(Код) <> Тип("Строка") Тогда
            ВызватьИсключение "Значения roles должны быть строками.";
        КонецЕсли;
        Роль = РольПоКоду(Код);
        Если Роль = Неопределено Тогда
            ВызватьИсключение "Недопустимая роль: " + Код;
        КонецЕсли;
        Если Роли.Найти(Роль) = Неопределено Тогда
            Роли.Добавить(Роль);
        КонецЕсли;
    КонецЦикла;
    Возврат Роли;
КонецФункции

// Признак наличия пароля для существующего GET /user/{phone}.
Функция ЕстьПарольПриложения(СсылкаПользователя)
    Набор = РегистрыСведений.ПаролиПользователейПриложения.СоздатьНаборЗаписей();
    Набор.Отбор.Пользователь.Установить(СсылкаПользователя);
    Набор.Прочитать();
    Если Набор.Количество() <> 1 Тогда
        Возврат Ложь;
    КонецЕсли;
    Для Каждого Запись Из Набор Цикл
        Возврат НЕ ПустаяСтрока(Запись.СохраняемоеЗначение);
    КонецЦикла;
    Возврат Ложь;
КонецФункции

Процедура ЗаписатьРоли(Ссылка, Роли)
    // Независимый непериодический регистр. Заменяем только записи пользователя.
    Набор = РегистрыСведений.РолиПользователей.СоздатьНаборЗаписей();
    Набор.Отбор.Пользователь.Установить(Ссылка);
    Для Каждого Роль Из Роли Цикл
        Запись = Набор.Добавить();
        Запись.Пользователь = Ссылка;
        Запись.Роль = Роль;
    КонецЦикла;
    Набор.Записать(Истина);
КонецПроцедуры

Функция ПолучитьРоли(Ссылка)
    ЗапросДанных = Новый Запрос;
    ЗапросДанных.Текст =
        "ВЫБРАТЬ Роль ИЗ РегистрСведений.РолиПользователей "
        + "ГДЕ Пользователь = &Пользователь";
    ЗапросДанных.УстановитьПараметр("Пользователь", Ссылка);
    Выборка = ЗапросДанных.Выполнить().Выбрать();

    Роли = Новый Массив;
    Пока Выборка.Следующий() Цикл
        Код = КодРоли(Выборка.Роль);
        Если НЕ ПустаяСтрока(Код) Тогда
            Роли.Добавить(Код);
        КонецЕсли;
    КонецЦикла;
    Возврат Роли;
КонецФункции

Функция ПредставлениеПользователя(Ссылка)
    Пользователь = Ссылка.ПолучитьОбъект();
    Данные = Новый Структура;     
	
	Данные.Вставить("onecId", Строка(Ссылка.УникальныйИдентификатор()));
    Данные.Вставить("phone", Пользователь.Телефон);
    Данные.Вставить("firstName", Пользователь.Имя);
    Данные.Вставить("lastName", Пользователь.Фамилия);
    Данные.Вставить("patronymic", Пользователь.Отчество);
    Данные.Вставить("messengerUserId", Пользователь.ИдентификаторMAX);
    Данные.Вставить("isActive", Пользователь.Активен);
	Данные.Вставить("hasPassword", ЕстьПарольПриложения(Ссылка));

    ДеньРождения = Неопределено;
	Если ЗначениеЗаполнено(Пользователь.ДатаРождения) Тогда
        ДеньРождения = Формат(Пользователь.ДатаРождения, "ДФ=yyyy-MM-dd");
    КонецЕсли;
    Данные.Вставить("birthday", ДеньРождения);
    Данные.Вставить("roles", ПолучитьРоли(Ссылка));
    Возврат Данные;
КонецФункции

Процедура ОбновитьСтроковоеПоле(Объект, Данные, ИмяJSON, ИмяРеквизита, Максимум, Обязательное)
    Значение = Неопределено;
    Если НЕ Данные.Свойство(ИмяJSON, Значение) Тогда
        Если Обязательное Тогда
            ВызватьИсключение "Отсутствует обязательное поле: " + ИмяJSON;
        КонецЕсли;
        Возврат;
    КонецЕсли;

    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        ВызватьИсключение "Поле " + ИмяJSON + " должно быть строкой.";
    КонецЕсли;
    Значение = СокрЛП(Значение);
    Если СтрДлина(Значение) > Максимум Тогда
        ВызватьИсключение "Некорректная длина поля: " + ИмяJSON;
    КонецЕсли;
    Объект[ИмяРеквизита] = Значение;
КонецПроцедуры

Процедура ПрименитьДанные(Объект, Данные, Создание, ПолнаяЗамена)
    ОбновитьСтроковоеПоле(Объект, Данные, "firstName", "Имя", 150, Создание Или ПолнаяЗамена);
    ОбновитьСтроковоеПоле(Объект, Данные, "lastName", "Фамилия", 150, Создание Или ПолнаяЗамена);
    ОбновитьСтроковоеПоле(Объект, Данные, "patronymic", "Отчество", 150, Ложь);
    ОбновитьСтроковоеПоле(Объект, Данные, "messengerUserId", "ИдентификаторMAX", 255, Ложь);

    Значение = Неопределено;
    Если Данные.Свойство("birthday", Значение) Тогда
        Если ТипЗнч(Значение) = Тип("Строка") И НЕ ПустаяСтрока(Значение) Тогда
            Если СтрДлина(Значение) <> 10
                Или Сред(Значение, 5, 1) <> "-"
                Или Сред(Значение, 8, 1) <> "-" Тогда
                ВызватьИсключение "Ожидается birthday в формате YYYY-MM-DD.";
            КонецЕсли;
            Объект.ДатаРождения = Дата(
                Число(Лев(Значение, 4)),
                Число(Сред(Значение, 6, 2)),
                Число(Сред(Значение, 9, 2))
            );
        ИначеЕсли ТипЗнч(Значение) = Тип("Null")
            Или ТипЗнч(Значение) = Тип("Неопределено")
            Или Значение = "" Тогда
            Объект.ДатаРождения = Дата(1, 1, 1);
        Иначе
            ВызватьИсключение "Некорректное поле birthday.";
        КонецЕсли;
    КонецЕсли;

    Если Данные.Свойство("isActive", Значение) Тогда
        Если ТипЗнч(Значение) <> Тип("Булево") Тогда
            ВызватьИсключение "Поле isActive должно быть булевым.";
        КонецЕсли;
        Объект.Активен = Значение;
    ИначеЕсли Создание Тогда
        Объект.Активен = Истина;
    КонецЕсли;

    ИмяДляСписка = СокрЛП(Объект.Фамилия + " " + Объект.Имя);
    Если ПустаяСтрока(ИмяДляСписка) Тогда
        ИмяДляСписка = Объект.Телефон;
    КонецЕсли;
    Объект.Наименование = Лев(ИмяДляСписка, 150);
КонецПроцедуры

Функция СохранитьПользователяHTTP(Запрос, Режим)
    // Режимы: POST / PUT / PATCH. Обновление телефона отдельной операцией.
    Попытка
        Данные = ПрочитатьТело(Запрос);
        ИзURL = "";
        Если Режим <> "POST" Тогда
            ИзURL = НормализоватьТелефон(Запрос.ПараметрыURL["phone"]);
            Если ПустаяСтрока(ИзURL) Тогда
                Возврат JSONОшибка(400, "invalid_phone", "Некорректный телефон в URL.");
            КонецЕсли;
        КонецЕсли;

        Телефон = ИзURL;
        Значение = Неопределено;
        Если Данные.Свойство("phone", Значение) Тогда
            ТелефонТела = НормализоватьТелефон(Значение);
            Если ПустаяСтрока(ТелефонТела) Тогда
                Возврат JSONОшибка(400, "invalid_phone", "Некорректный телефон в JSON.");
            КонецЕсли;
            Если НЕ ПустаяСтрока(ИзURL) И ТелефонТела <> ИзURL Тогда
                Возврат JSONОшибка(409, "phone_mismatch", "Телефон в URL и JSON различается.");
            КонецЕсли;
            Телефон = ТелефонТела;
        КонецЕсли;
        Если ПустаяСтрока(Телефон) Тогда
            Возврат JSONОшибка(400, "invalid_phone", "Поле phone обязательно.");
        КонецЕсли;

        Ссылка = НайтиПоТелефону(Телефон);
        Создание = Ссылка.Пустая();
        Если Режим = "POST" И НЕ Создание Тогда
            Возврат JSONОшибка(409, "user_exists", "Пользователь с таким телефоном уже существует.");
        КонецЕсли;
        Если Режим = "PATCH" И Создание Тогда
            Возврат JSONОшибка(404, "user_not_found", "Пользователь не найден.");
        КонецЕсли;

        Если Создание Тогда
            Объект = Справочники.ПользователиПриложения.СоздатьЭлемент();
        Иначе
            Объект = Ссылка.ПолучитьОбъект();
        КонецЕсли;

        Объект.Код = Телефон;
        Объект.Телефон = Телефон;
        ПрименитьДанные(Объект, Данные, Создание, Режим = "PUT");  
		
        ПарольРегистрации = Неопределено;
        Если Данные.Свойство("password", Значение) Тогда
            Если Режим <> "POST" Тогда
                Возврат JSONОшибка(400, "password_not_supported",
                    "Поле password допускается только при создании пользователя.");
            КонецЕсли;
            Если ТипЗнч(Значение) <> Тип("Строка") Тогда
                Возврат JSONОшибка(400, "invalid_password",
                    "Пароль должен быть строкой.");
            КонецЕсли;
            Если СтрДлина(Значение) < 8
                Или СтрДлина(Значение) > 128 Тогда
                Возврат JSONОшибка(400, "invalid_password",
                    "Длина пароля должна быть от 8 до 128 символов.");
            КонецЕсли;
            ПарольРегистрации = Значение;
		КонецЕсли;
		
        Роли = Неопределено;
        Если Данные.Свойство("roles", Значение) Тогда
            Роли = ПроверитьРоли(Значение);
        ИначеЕсли Создание Тогда
            Роли = Новый Массив;
            Роли.Добавить(Перечисления.РолиПользователей.Пользователь);
        ИначеЕсли Режим = "PUT" Тогда
            ВызватьИсключение "При PUT требуется поле roles.";
        КонецЕсли;
    Исключение
        Возврат JSONОшибка(400, "invalid_request", ОписаниеОшибки());
    КонецПопытки;

    Попытка
        НачатьТранзакцию();
        Объект.Записать();
        Ссылка = Объект.Ссылка;
        Если Роли <> Неопределено Тогда
            ЗаписатьРоли(Ссылка, Роли);
		КонецЕсли;
		Если ПарольРегистрации <> Неопределено Тогда
            УстановитьПарольПриложения(Ссылка, ПарольРегистрации);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
	Исключение
		Подробности = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации("ServiceCarAPI.ЗаписьПользователя", УровеньЖурналаРегистрации.Ошибка, , ,"Метод: " + Режим + Символы.ПС + Подробности);
        Возврат JSONОшибка(500, "onec_write_failed", "Ошибка записи пользователя в 1С.");
    КонецПопытки;

	// Сохранение уже подтверждено. Ошибку чтения ответа нельзя выдавать за
    // откат транзакции: в таком случае GET позволит найти запись.
    Попытка
        Результат = Новый Структура;
        Результат.Вставить("user", ПредставлениеПользователя(Ссылка));
        Если Создание Тогда
            Возврат JSONОтвет(201, Результат);
        КонецЕсли;
        Возврат JSONОтвет(200, Результат);
    Исключение
        ЗаписьЖурналаРегистрации("ServiceCarAPI.ОтветПослеЗаписи",
            УровеньЖурналаРегистрации.Ошибка, , ,
            ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
        Возврат JSONОшибка(500, "onec_readback_failed",
            "Пользователь сохранён, но не удалось сформировать ответ. Проверьте через GET.");
    КонецПопытки;
КонецФункции

Функция НайтиЦифрыВСтроке(Значение)
    Цифры = "";
    Для Индекс = 1 По СтрДлина(Значение) Цикл
        Символ = Сред(Значение, Индекс, 1);
        Если Найти("0123456789", Символ) > 0 Тогда
            Цифры = Цифры + Символ;
        КонецЕсли;
    КонецЦикла;
    Возврат Цифры;
КонецФункции

Функция СовпадаетПоискСпециалиста(Данные, Поиск)
    Если ПустаяСтрока(Поиск) Тогда
        Возврат Ложь;
    КонецЕсли;

    Для Каждого Слово Из СтрРазделить(НРег(Поиск), " ", Ложь) Цикл
        Если ПустаяСтрока(Слово) Тогда
            Продолжить;
        КонецЕсли;

        Подходит = Найти(НРег(Данные.Имя), Слово) > 0
            Или Найти(НРег(Данные.Фамилия), Слово) > 0
            Или Найти(НРег(Данные.Отчество), Слово) > 0;

        Цифры = НайтиЦифрыВСтроке(Слово);
        Если НЕ ПустаяСтрока(Цифры) Тогда
            Подходит = Подходит Или Найти(Данные.Телефон, Цифры) > 0;
        КонецЕсли;

        Если НЕ Подходит Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

