// ===== ВАЛИДАЦИЯ И ТРАНЗАКЦИОННАЯ ЗАПИСЬ ЗАКАЗОВ =====

Процедура ЗаказЗаполнитьСнимки(Объект)
    Клиент = Объект.Клиент.ПолучитьОбъект();
    Авто = Объект.Автомобиль.ПолучитьОбъект();
    Если Клиент = Неопределено Или Авто = Неопределено
        Или Клиент.ПометкаУдаления Или Авто.ПометкаУдаления Тогда
        ВызватьИсключение "Пользователь или автомобиль не найден.";
    КонецЕсли;
    Если Авто.ВладелецАвтомобиля <> Объект.Клиент Или Авто.ВАрхиве Тогда
        ВызватьИсключение "Выбранный автомобиль не принадлежит клиенту или архивирован.";
    КонецЕсли;
    Объект.ТелефонКлиентаСнимок = Лев(Клиент.Телефон, 20);
    Объект.ФиоКлиентаСнимок = Лев(СокрЛП(
        Клиент.Фамилия + " " + Клиент.Имя + " " + Клиент.Отчество), 150);
    Объект.МаркаАвтомобиля = Авто.Марка;
    Объект.МодельАвтомобиля = Авто.Модель;
    Объект.МаркаСнимок = Авто.Марка.Наименование;
    Объект.МодельСнимок = Авто.Модель.Наименование;
    Объект.ГодВыпускаСнимок = Авто.ГодВыпуска;
    Объект.VINСнимок = Авто.VIN;
    Объект.ГосНомерСнимок = Авто.ГосНомер;
КонецПроцедуры

Функция ЗаказСтрокаИзJSON(Данные, Ключ, Обязательное = Ложь)
    Значение = Неопределено;
    Если НЕ Данные.Свойство(Ключ, Значение) Тогда
        Если Обязательное Тогда
            ВызватьИсключение "Отсутствует поле " + Ключ;
        КонецЕсли;
        Возврат Неопределено;
    КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        ВызватьИсключение "Поле " + Ключ + " должно быть строкой.";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Процедура ЗаказПрименитьРаботы(Объект, Работы, Автор)
    Если ТипЗнч(Работы) <> Тип("Массив") Тогда
        ВызватьИсключение "Поле works должно быть массивом.";
    КонецЕсли;
    НовыеРаботы = Новый ТаблицаЗначений;
    НовыеРаботы.Колонки.Добавить("Вид");
    НовыеРаботы.Колонки.Добавить("Цена");
    НовыеРаботы.Колонки.Добавить("ИД");
    Виды = Новый Массив;
    Для Каждого ДанныеРаботы Из Работы Цикл
        Если ТипЗнч(ДанныеРаботы) <> Тип("Структура") Тогда
            ВызватьИсключение "Строка works должна быть JSON-объектом.";
        КонецЕсли;
        Если ДанныеРаботы.Свойство("name") Или ДанныеРаботы.Свойство("workTypes") Тогда
            ВызватьИсключение "Произвольные названия работ запрещены.";
        КонецЕсли;
        ИДВида = ЗаказСтрокаИзJSON(ДанныеРаботы, "workTypeId", Истина);
        Вид = ЗаказПолучитьСсылку("ВидыРабот", ИДВида);
        Если Виды.Найти(Вид) <> Неопределено Тогда
            ВызватьИсключение "Один вид работы нельзя указать дважды.";
        КонецЕсли;
        Виды.Добавить(Вид);
        Новая = НовыеРаботы.Добавить();
        Новая.Вид = Вид;
        // Сохраняем ранее установленную цену, если менеджер не прислал
        // новую; пользователь никогда не может менять цену.
        Цена = 0;
        Для Каждого СтараяЦена Из Объект.Работы Цикл
            Если СтараяЦена.ВидРабот = Вид Тогда
                Цена = СтараяЦена.Цена;
                Прервать;
            КонецЕсли;
        КонецЦикла;
        Если ЗаказМенеджер(Автор) Тогда
            Если ДанныеРаботы.Свойство("price", Цена) Тогда
                Если ТипЗнч(Цена) = Тип("Строка") Тогда
                    Попытка
                        Цена = Число(СтрЗаменить(Цена, ".", ","));
                    Исключение
                        ВызватьИсключение "Некорректная цена работы.";
                    КонецПопытки;
                КонецЕсли;
                Если ТипЗнч(Цена) <> Тип("Число") Или Цена < 0
                    Или Цена > 9999999999.99 Тогда
                    ВызватьИсключение "Недопустимая цена работы.";
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;
        Новая.Цена = Цена;
        // При сохранении переданного id проверяется принадлежность прежней строке.
        ИДСтроки = Неопределено;
        Если ДанныеРаботы.Свойство("id", ИДСтроки) И ИДСтроки <> Неопределено Тогда
            ИДСтроки = Строка(АвтоUUIDСтрокой(ИДСтроки));
            Принадлежит = Ложь;
            Для Каждого Старая Из Объект.Работы Цикл
                Если Старая.ИдентификаторСтроки = ИДСтроки И
                    Старая.ВидРабот = Вид Тогда
                    Принадлежит = Истина;
                    Прервать;
                КонецЕсли;
            КонецЦикла;
            Если НЕ Принадлежит Тогда
                ВызватьИсключение "Строка работы не принадлежит этому заказу.";
            КонецЕсли;
        Иначе
            // Сохраняем ID неизменной строки при PATCH без id.
            Для Каждого Старая Из Объект.Работы Цикл
                Если Старая.ВидРабот = Вид И НЕ ПустаяСтрока(Старая.ИдентификаторСтроки) Тогда
                    ИДСтроки = Старая.ИдентификаторСтроки;
                    Прервать;
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        Если ИДСтроки = Неопределено Тогда
            ИДСтроки = Строка(Новый УникальныйИдентификатор);
        КонецЕсли;
        Новая.ИД = ИДСтроки;
    КонецЦикла;
    Объект.Работы.Очистить();
    Для Каждого Стр Из НовыеРаботы Цикл
        Новая = Объект.Работы.Добавить();
        Новая.ВидРабот = Стр.Вид;
        Новая.Цена = Стр.Цена;
        Новая.ИдентификаторСтроки = Стр.ИД;
    КонецЦикла;
КонецПроцедуры

Процедура ЗаказПрименитьСпециалистов(Объект, Специалисты)
    Если ТипЗнч(Специалисты) <> Тип("Массив") Тогда
        ВызватьИсключение "Поле mechanics должно быть массивом.";
    КонецЕсли;
    Ссылки = Новый Массив;
    Для Каждого ИД Из Специалисты Цикл
        Ссылка = АвтоПолучитьСсылку("ПользователиПриложения", ИД);
        Пользователь = Ссылка.ПолучитьОбъект();
        Если Пользователь.ПометкаУдаления Или НЕ Пользователь.Активен
            Или ПолучитьРоли(Ссылка).Найти("mechanic") = Неопределено Тогда
            ВызватьИсключение "Выбранный специалист неактивен или не имеет роли специалиста.";
        КонецЕсли;
        Если Ссылки.Найти(Ссылка) <> Неопределено Тогда
            ВызватьИсключение "Специалист уже назначен на этот заказ.";
        КонецЕсли;
        Ссылки.Добавить(Ссылка);
    КонецЦикла;
    Объект.Специалисты.Очистить();
    Для Каждого Ссылка Из Ссылки Цикл
        Стр = Объект.Специалисты.Добавить();
        Стр.Специалист = Ссылка;
    КонецЦикла;
КонецПроцедуры

Процедура ЗаказПрименитьПоля(Объект, Данные, Автор, Создание)
    Если Данные.Свойство("workTypes") Тогда
        ВызватьИсключение "Текстовые виды работ не поддерживаются.";
    КонецЕсли;
    Если Данные.Свойство("status") Или Данные.Свойство("workStatus")
        Или Данные.Свойство("paymentStatus") Или Данные.Свойство("client")
        Или Данные.Свойство("ownerId") Или Данные.Свойство("customerId")
        Или Данные.Свойство("price") Тогда
        ВызватьИсключение "Поле доступно только для чтения.";
    КонецЕсли;
    Если Создание Тогда
        ИДАвто = ЗаказСтрокаИзJSON(Данные, "car", Истина);
        Объект.Клиент = Автор.Ссылка;
        Объект.Автомобиль = АвтоПолучитьСсылку("Автомобили", ИДАвто);
        ЗаказЗаполнитьСнимки(Объект);
        Объект.СтатусЗаказа = ЗаказСтатусПоКоду("СтатусыЗаказов", "under_review");
        Объект.СтатусРабот = ЗаказСтатусПоКоду("СтатусыРабот", "waiting_manager_review");
        Объект.СтатусОплаты = ЗаказСтатусПоКоду("СтатусыОплаты", "unpaid");
    ИначеЕсли Данные.Свойство("car") Тогда
        ВызватьИсключение "Автомобиль заказа изменить нельзя.";
    КонецЕсли;

    Права = ЗаказРазрешения(Объект, Автор);
    Если Данные.Свойство("works") Тогда
        Если НЕ Создание И НЕ Права.canEditWorks Тогда
            ВызватьИсключение "Редактирование работ недоступно.";
        КонецЕсли;
        Работы = Неопределено;
        Данные.Свойство("works", Работы);
        ЗаказПрименитьРаботы(Объект, Работы, Автор);
    КонецЕсли;
    Если Данные.Свойство("mechanics") Тогда
        Специалисты = Неопределено;
        Данные.Свойство("mechanics", Специалисты);
        Если Создание Тогда
            Если ТипЗнч(Специалисты) <> Тип("Массив") Или Специалисты.Количество() > 0 Тогда
                ВызватьИсключение "Назначение специалистов при создании клиентом запрещено.";
            КонецЕсли;
        Иначе
            Если НЕ Права.canAssignMechanics Тогда
                ВызватьИсключение "Изменение списка специалистов недоступно.";
            КонецЕсли;
            ЗаказПрименитьСпециалистов(Объект, Специалисты);
        КонецЕсли;
    КонецЕсли;
    Если Данные.Свойство("description") Тогда
        Если НЕ Создание И НЕ Права.canEditDescription Тогда
            ВызватьИсключение "Редактирование описания недоступно.";
        КонецЕсли;
        Объект.Описание = ЗаказСтрокаИзJSON(Данные, "description");
    КонецЕсли;
    Если Данные.Свойство("refusalReason") Тогда
        ВызватьИсключение "Причина отказа изменяется только командой статуса.";
    КонецЕсли;
    Если Данные.Свойство("appointmentAt") Тогда
        Если НЕ Создание И НЕ Права.canEditAppointment Тогда
            ВызватьИсключение "Изменение времени записи недоступно.";
        КонецЕсли;
        Текст = ЗаказСтрокаИзJSON(Данные, "appointmentAt", Истина);
        Объект.ДатаЗаписи = ЗаказРазобратьДату(Текст, Истина);
    ИначеЕсли Создание Тогда
        ВызватьИсключение "Выберите время записи.";
    КонецЕсли;
КонецПроцедуры

// Блокировка на всю таблицу во избежание гонки проверка -> запись.
// Реализовано консервативно (одна запись за раз); после замеров можно
// сузить блокировку до конкретной даты с соблюдением блокировок 1С.
Процедура ЗаказЗаблокироватьРасписание()
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрСведений.ЗанятыеИнтервалы");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура ЗаказЗаблокироватьДокумент(Ссылка)
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("Документ.ЗаказыНаОбслуживание");
    Элемент.УстановитьЗначение("Ссылка", Ссылка);
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура ЗаказПроверитьСлот(ДатаЗаписи, СсылкаЗаказа)
    Настройки = ЗаказНастройкиЗаписи();
    Если ДатаЗаписи <= ТекущаяДата() Тогда
        ВызватьИсключение "Дата записи должна быть в будущем.";
    КонецЕсли;
    ДатаДня = НачалоДня(ДатаЗаписи);
    НачалоМинут = Час(ДатаЗаписи) * 60 + Минута(ДатаЗаписи);
    Если Секунда(ДатаЗаписи) <> 0 Тогда
        ВызватьИсключение "Начало записи должно быть кратно минуте.";
    КонецЕсли;
    График = ЗаказГрафикДня(ДатаДня);
    Если НЕ График.Рабочий Или НачалоМинут < График.Начало
        Или НачалоМинут + Настройки.Длительность > График.Конец
        Или (НачалоМинут - График.Начало) % Настройки.Интервал <> 0 Тогда
        ВызватьИсключение "Время записи не входит в рабочий график.";
    КонецЕсли;
    Если ЗаказПересекается(НачалоМинут, НачалоМинут + Настройки.Длительность,
        ЗаказИнтервалыДня(ДатаДня, "БлокировкиЗаписи")) Тогда
        ВызватьИсключение "Время перекрыто блокировкой графика.";
    КонецЕсли;
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ НачалоМинут, КонецМинут, Заказ "
        + "ИЗ РегистрСведений.ЗанятыеИнтервалы ГДЕ Дата = &Дата";
    З.УстановитьПараметр("Дата", ДатаДня);
    В = З.Выполнить().Выбрать();
    Пока В.Следующий() Цикл
        Если НЕ СсылкаЗаказа.Пустая() И В.Заказ = СсылкаЗаказа Тогда
            Продолжить;
        КонецЕсли;
        Если НачалоМинут < В.КонецМинут
            И НачалоМинут + Настройки.Длительность > В.НачалоМинут Тогда
            ВызватьИсключение "Время уже занято другим заказом.";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ЗаказСнятьБронь(СсылкаЗаказа)
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Дата, НачалоМинут, ИдентификаторИнтервала "
        + "ИЗ РегистрСведений.ЗанятыеИнтервалы ГДЕ Заказ = &Заказ";
    З.УстановитьПараметр("Заказ", СсылкаЗаказа);
    В = З.Выполнить().Выбрать();
    Пока В.Следующий() Цикл
        Набор = РегистрыСведений.ЗанятыеИнтервалы.СоздатьНаборЗаписей();
        Набор.Отбор.Дата.Установить(В.Дата);
        Набор.Отбор.НачалоМинут.Установить(В.НачалоМинут);
        Набор.Отбор.ИдентификаторИнтервала.Установить(В.ИдентификаторИнтервала);
        Набор.Прочитать();
        Набор.Очистить();
        Набор.Записать();
    КонецЦикла;
КонецПроцедуры

Процедура ЗаказСоздатьБронь(СсылкаЗаказа, ДатаЗаписи)
    Если НЕ ЗначениеЗаполнено(ДатаЗаписи) Тогда
        Возврат;
    КонецЕсли;
    Настройки = ЗаказНастройкиЗаписи();
    ДатаДня = НачалоДня(ДатаЗаписи);
    НачалоМинут = Час(ДатаЗаписи) * 60 + Минута(ДатаЗаписи);
    Набор = РегистрыСведений.ЗанятыеИнтервалы.СоздатьНаборЗаписей();
    Запись = Набор.Добавить();
    Запись.Дата = ДатаДня;
    Запись.НачалоМинут = НачалоМинут;
    Запись.ИдентификаторИнтервала = Строка(Новый УникальныйИдентификатор);
    Запись.КонецМинут = НачалоМинут + Настройки.Длительность;
    Запись.Заказ = СсылкаЗаказа;
    Набор.Записать(Ложь);
КонецПроцедуры

Функция OrdersPost(Запрос)
    Попытка
        Автор = ЗаказАвтор(Запрос);
        Если Автор.Код <> "user" Тогда
            Возврат JSONОшибка(403, "forbidden", "Создавать заказы может только клиент.");
        КонецЕсли;
        Данные = ПрочитатьТело(Запрос);
        Объект = Документы.ЗаказыНаОбслуживание.СоздатьДокумент();
        // Стандартный реквизит документа Дата — момент оформления.
        // ДатаЗаписи заполняется отдельно из appointmentAt и не меняется.
        Объект.Дата = ТекущаяДата();
        ЗаказПрименитьПоля(Объект, Данные, Автор, Истина);
    Исключение
        Возврат JSONОшибка(400, "invalid_order", ОписаниеОшибки());
    КонецПопытки;
    // Ошибка в 1С при записи документа / регистра не равна занятому слоту.
    // Техническая причина всегда журналируется с точным этапом и UUID.
    Этап = "начало транзакции";
    Попытка
        НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
        Этап = "блокировка регистра ЗанятыеИнтервалы";
        ЗаказЗаблокироватьРасписание();
        Этап = "проверка доступности";
        ЗаказПроверитьСлот(Объект.ДатаЗаписи,
            Документы.ЗаказыНаОбслуживание.ПустаяСсылка());
        Этап = "запись документа ЗаказыНаОбслуживание";
        Объект.Записать();
        Этап = "запись регистра ЗанятыеИнтервалы";
        // Регистрация интервала выполняется в ПриЗаписи модуля объекта.
        Этап = "фиксация транзакции";
        ЗафиксироватьТранзакцию();
    Исключение
        КраткаяОшибка = ОписаниеОшибки();
        Подробности = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        КодСобытия = Строка(Новый УникальныйИдентификатор);
        Попытка
            ОтменитьТранзакцию();
        Исключение
            ЗаписьЖурналаРегистрации("ServiceCarAPI.OrderRollback",
                УровеньЖурналаРегистрации.Ошибка, , ,
                "Событие " + КодСобытия + "; Ошибка отката: "
                + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
        КонецПопытки;
        ЗаписьЖурналаРегистрации("ServiceCarAPI.OrderCreate",
            УровеньЖурналаРегистрации.Ошибка, , ,
            "Событие " + КодСобытия + "; Этап: " + Этап
            + "; Ошибка: " + Подробности);
        // 409 только при известной и ожидаемой причине отказа в записи.
        Если Этап = "проверка доступности"
            И (Найти(КраткаяОшибка, "Время уже занято другим заказом") > 0
            Или Найти(КраткаяОшибка, "Время перекрыто блокировкой") > 0
            Или Найти(КраткаяОшибка, "Время записи не входит в рабочий график") > 0
            Или Найти(КраткаяОшибка, "Дата записи должна быть в будущем") > 0
            Или Найти(КраткаяОшибка, "Начало записи должно быть кратно минуте") > 0) Тогда
            Возврат JSONОшибка(409, "order_slot_unavailable",
                "Выбранное время сейчас недоступно. Код события: " + КодСобытия);
        КонецЕсли;
        Возврат JSONОшибка(500, "order_create_failed",
            "Ошибка сохранения заказа в 1С. Код события: " + КодСобытия);
    КонецПопытки;
    Возврат JSONОтвет(201, ЗаказJSON(Объект, Автор));
КонецФункции

Функция OrderByIdPatch(Запрос)
    Попытка
        Автор = ЗаказАвтор(Запрос);
        Ссылка = ЗаказДокументСсылка(Запрос.ПараметрыURL["id"]);
        Объект = Ссылка.ПолучитьОбъект();
        ЗаказПроверитьВидимость(Объект, Автор);
        Данные = ПрочитатьТело(Запрос);
        // Предварительные проверки; окончательные под транзакцией ниже.
        ЗаказПрименитьПоля(Объект, Данные, Автор, Ложь);
    Исключение
        Возврат JSONОшибка(400, "invalid_order", ОписаниеОшибки());
    КонецПопытки;

    Попытка
        НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
        ЗаказЗаблокироватьРасписание();
        ЗаказЗаблокироватьДокумент(Ссылка);
        // Повторно читаем объект под блокировкой, затем применяем payload.
        Объект = Ссылка.ПолучитьОбъект();
        ЗаказПроверитьВидимость(Объект, Автор);
        ЗаказПрименитьПоля(Объект, Данные, Автор, Ложь);
        Если Данные.Свойство("appointmentAt") Тогда
            ЗаказПроверитьСлот(Объект.ДатаЗаписи, Ссылка);
        КонецЕсли;
        Объект.Записать();
        // ПриЗаписи объекта обновляет бронь при изменении даты.
        ЗафиксироватьТранзакцию();
    Исключение
        Подробности = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        ОтменитьТранзакцию();
        ЗаписьЖурналаРегистрации("ServiceCarAPI.OrderUpdate",
            УровеньЖурналаРегистрации.Ошибка, , , Подробности);
        Возврат JSONОшибка(409, "order_update_failed", "Изменение заказа не удалось.");
    КонецПопытки;
    Возврат JSONОтвет(200, ЗаказJSON(Объект, Автор));
КонецФункции

// ===== СВОБОДНОЕ ИЗМЕНЕНИЕ ТРЁХ НЕЗАВИСИМЫХ СТАТУСОВ =====
// Только менеджер. Нет таблиц переходов, автоматических смен смежного статуса,
// требования оплаты перед execution и скрытой логики отмены при completed.

Функция ЗаказИзменитьСтатус(Запрос, Вид)
    Попытка
        Автор = ЗаказАвтор(Запрос);
        Если НЕ ЗаказМенеджер(Автор) Тогда
            Возврат JSONОшибка(403, "forbidden",
                "Изменение статусов доступно только менеджеру.");
        КонецЕсли;
        Ссылка = ЗаказДокументСсылка(Запрос.ПараметрыURL["id"]);
        Данные = ПрочитатьТело(Запрос);
        ИД = ЗаказСтрокаИзJSON(Данные, "statusId", Истина);
        Если Вид = "order" Тогда
            НовыйСтатус = ЗаказПолучитьСсылку("СтатусыЗаказов", ИД);
        ИначеЕсли Вид = "work" Тогда
            НовыйСтатус = ЗаказПолучитьСсылку("СтатусыРабот", ИД);
        ИначеЕсли Вид = "payment" Тогда
            НовыйСтатус = ЗаказПолучитьСсылку("СтатусыОплаты", ИД);
        Иначе
            ВызватьИсключение "Неизвестный вид статуса.";
        КонецЕсли;
        Причина = Неопределено;
        Если Данные.Свойство("refusalReason") Тогда
            Если Вид <> "order" Тогда
                ВызватьИсключение "Причина отказа поддерживается только для статуса заказа.";
            КонецЕсли;
            Причина = ЗаказСтрокаИзJSON(Данные, "refusalReason");
        КонецЕсли;
    Исключение
        Возврат JSONОшибка(400, "invalid_status", ОписаниеОшибки());
    КонецПопытки;
    Попытка
        НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
        ЗаказЗаблокироватьДокумент(Ссылка);
        Объект = Ссылка.ПолучитьОбъект();
        Если Объект = Неопределено Или Объект.ПометкаУдаления Тогда
            ВызватьИсключение "Заказ не найден.";
        КонецЕсли;
        Если Вид = "order" Тогда
            Объект.СтатусЗаказа = НовыйСтатус;
            Если Причина <> Неопределено Тогда
                Объект.ПричинаОтказа = Причина;
            КонецЕсли;
        ИначеЕсли Вид = "work" Тогда
            Объект.СтатусРабот = НовыйСтатус;
        Иначе
            Объект.СтатусОплаты = НовыйСтатус;
        КонецЕсли;
        Объект.Записать();
        ЗафиксироватьТранзакцию();
    Исключение
        Подробности = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        ОтменитьТранзакцию();
        ЗаписьЖурналаРегистрации("ServiceCarAPI.OrderStatus",
            УровеньЖурналаРегистрации.Ошибка, , , Подробности);
        Возврат JSONОшибка(409, "status_write_failed",
            "Не удалось изменить статус заказа.");
    КонецПопытки;
    Возврат JSONОтвет(200, ЗаказJSON(Объект, Автор));
КонецФункции

Функция OrderTransitionStatusPost(Запрос)
    Возврат ЗаказИзменитьСтатус(Запрос, "order");
КонецФункции

Функция OrderTransitionWorkStatusPost(Запрос)
    Возврат ЗаказИзменитьСтатус(Запрос, "work");
КонецФункции

Функция OrderPaymentStatusPost(Запрос)
    Возврат ЗаказИзменитьСтатус(Запрос, "payment");
КонецФункции