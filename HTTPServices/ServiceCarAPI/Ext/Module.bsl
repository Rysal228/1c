КонецФункции

Функция CarModelsGet(Запрос)
    СтрокаМарки = Запрос.ПараметрыЗапроса.Получить("brand");
    СсылкаМарки = Неопределено;
    Если СтрокаМарки <> Неопределено И НЕ ПустаяСтрока(СтрокаМарки) Тогда
        Попытка
            ИДМарки = Новый УникальныйИдентификатор(СокрЛП(СтрокаМарки));
            СсылкаМарки = Справочники.МаркиАвтомобилей.ПолучитьСсылку(ИДМарки);
            Если СсылкаМарки.ПолучитьОбъект() = Неопределено Тогда
                Возврат JSONОшибка(400, "invalid_brand", "Неизвестная марка автомобиля.");
            КонецЕсли;
        Исключение
            Возврат JSONОшибка(400, "invalid_brand", "Некорректная марка автомобиля.");
        КонецПопытки;
    КонецЕсли;

    Попытка
        ЗапросДанных = Новый Запрос;
        ЗапросДанных.Текст =
            "ВЫБРАТЬ
            |   Модели.Ссылка КАК Ссылка,
            |   Модели.Наименование КАК Наименование,
            |   Модели.Марка КАК Марка
            |ИЗ
            |   Справочник.МоделиАвтомобилей КАК Модели
            |ГДЕ
            |   НЕ Модели.ПометкаУдаления
            |   И (&БезОтбора ИЛИ Модели.Марка = &Марка)
            |УПОРЯДОЧИТЬ ПО
            |   Наименование";
        ЗапросДанных.УстановитьПараметр("БезОтбора", СсылкаМарки = Неопределено);
        Если СсылкаМарки = Неопределено Тогда
            СсылкаМарки = Справочники.МаркиАвтомобилей.ПустаяСсылка();
        КонецЕсли;
        ЗапросДанных.УстановитьПараметр("Марка", СсылкаМарки);
        Результат = Новый Массив;
        Выборка = ЗапросДанных.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Если Выборка.Марка.Пустая() Тогда
                Продолжить;
            КонецЕсли;
            Элемент = Новый Структура;
            Элемент.Вставить("id", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
            Элемент.Вставить("name", Выборка.Наименование);
            Элемент.Вставить("brand", Строка(Выборка.Марка.УникальныйИдентификатор()));
            Результат.Добавить(Элемент);
        КонецЦикла;
        Возврат JSONОтвет(200, Результат);
    Исключение
        ЗаписьЖурналаРегистрации("ServiceCarAPI.CarModelsGet",
            УровеньЖурналаРегистрации.Ошибка, , ,
            ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
        Возврат JSONОшибка(500, "models_unavailable", "Не удалось получить модели автомобилей.");
    КонецПопытки;
КонецФункции


Функция АвтоUUIDСтрокой(ТекстИД)
    Попытка
        Возврат Новый УникальныйИдентификатор(СокрЛП(ТекстИД));
    Исключение
        ВызватьИсключение "Некорректный идентификатор ссылки 1С.";
    КонецПопытки;
КонецФункции

Функция АвтоПолучитьСсылку(ИмяСправочника, ТекстИД)
    ИД = АвтоUUIDСтрокой(ТекстИД);
    Если ИмяСправочника = "Автомобили" Тогда
        Ссылка = Справочники.Автомобили.ПолучитьСсылку(ИД);
    ИначеЕсли ИмяСправочника = "МаркиАвтомобилей" Тогда
        Ссылка = Справочники.МаркиАвтомобилей.ПолучитьСсылку(ИД);
    ИначеЕсли ИмяСправочника = "МоделиАвтомобилей" Тогда
        Ссылка = Справочники.МоделиАвтомобилей.ПолучитьСсылку(ИД);
    ИначеЕсли ИмяСправочника = "ПользователиПриложения" Тогда
        Ссылка = Справочники.ПользователиПриложения.ПолучитьСсылку(ИД);
    Иначе
        ВызватьИсключение "Неизвестный тип справочника.";
    КонецЕсли;
    Если Ссылка.ПолучитьОбъект() = Неопределено Тогда
        ВызватьИсключение "Элемент справочника не найден.";
    КонецЕсли;
    Возврат Ссылка;
КонецФункции

Функция АвтоJSON(Ссылка)
    Объект = Ссылка.ПолучитьОбъект();
    Если Объект = Неопределено Или Объект.ПометкаУдаления Тогда
        Возврат Неопределено;
    КонецЕсли;
    Данные = Новый Структура;
    Данные.Вставить("id", Строка(Ссылка.УникальныйИдентификатор()));
    Данные.Вставить("ownerId", Строка(Объект.ВладелецАвтомобиля.УникальныйИдентификатор()));
    Данные.Вставить("brand", Строка(Объект.Марка.УникальныйИдентификатор()));
    Данные.Вставить("model", Строка(Объект.Модель.УникальныйИдентификатор()));
    Данные.Вставить("brandName", Объект.Марка.Наименование);
    Данные.Вставить("modelName", Объект.Модель.Наименование);
    Данные.Вставить("year", Объект.ГодВыпуска);
    Данные.Вставить("vin", Объект.VIN);
    Данные.Вставить("plate_number", Объект.ГосНомер);
    Данные.Вставить("status", ?(Объект.ВАрхиве, "archived", "active"));
    ФотоURI = Неопределено;
    Если Объект.Фото <> Неопределено Тогда
        Если ТипЗнч(Объект.Фото) = Тип("ХранилищеЗначения") Тогда
            ДвоичныеДанныеФото = Объект.Фото.Получить();
            Если ТипЗнч(ДвоичныеДанныеФото) = Тип("ДвоичныеДанные") Тогда
                ФотоURI = "data:" + Объект.ФорматФото + ";base64,"
                    + Base64Строка(ДвоичныеДанныеФото);
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;
    Данные.Вставить("photo", ФотоURI);
    Возврат Данные;
КонецФункции

Функция CarsGet(Запрос)
    Попытка
        ВладелецИД = Запрос.ПараметрыЗапроса.Получить("owner");
        ОтборПоВладельцу = ВладелецИД <> Неопределено И НЕ ПустаяСтрока(ВладелецИД);
        Если ОтборПоВладельцу Тогда
            Владелец = АвтоПолучитьСсылку("ПользователиПриложения", ВладелецИД);
        Иначе
            Владелец = Справочники.ПользователиПриложения.ПустаяСсылка();
        КонецЕсли;
        ЗапросДанных = Новый Запрос;
        ЗапросДанных.Текст =
            "ВЫБРАТЬ
            |   Автомобили.Ссылка КАК Ссылка
            |ИЗ
            |   Справочник.Автомобили КАК Автомобили
            |ГДЕ
            |   НЕ Автомобили.ПометкаУдаления
            |   И (&ВсеВладельцы ИЛИ Автомобили.ВладелецАвтомобиля = &Владелец)";
        ЗапросДанных.УстановитьПараметр("ВсеВладельцы", НЕ ОтборПоВладельцу);
        ЗапросДанных.УстановитьПараметр("Владелец", Владелец);
        Результат = Новый Массив;
        Выборка = ЗапросДанных.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Данные = АвтоJSON(Выборка.Ссылка);
            Если Данные <> Неопределено Тогда
                Результат.Добавить(Данные);
            КонецЕсли;
        КонецЦикла;
        Возврат JSONОтвет(200, Результат);
    Исключение
        ЗаписьЖурналаРегистрации("ServiceCarAPI.CarsGet",
            УровеньЖурналаРегистрации.Ошибка, , ,
            ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
        Возврат JSONОшибка(500, "cars_unavailable", "Не удалось получить автомобили.");
    КонецПопытки;
КонецФункции

Функция CarByIdGet(Запрос)
    Попытка
        Ссылка = АвтоПолучитьСсылку("Автомобили", Запрос.ПараметрыURL["id"]);
        Возврат JSONОтвет(200, АвтоJSON(Ссылка));
    Исключение
        Возврат JSONОшибка(404, "car_not_found", "Автомобиль не найден.");
    КонецПопытки;
КонецФункции

Процедура АвтоПрименитьJSON(Объект, Данные, Создание)
    Если Создание Тогда
        Объект.ВладелецАвтомобиля = АвтоПолучитьСсылку("ПользователиПриложения", Данные.ownerId);
    КонецЕсли;
    Значение = Неопределено;
    Если Данные.Свойство("brand", Значение) Тогда
        Объект.Марка = АвтоПолучитьСсылку("МаркиАвтомобилей", Значение);
    КонецЕсли;
    Если Данные.Свойство("model", Значение) Тогда
        Объект.Модель = АвтоПолучитьСсылку("МоделиАвтомобилей", Значение);
    КонецЕсли;
    Если Данные.Свойство("year", Значение) Тогда
        Если ТипЗнч(Значение) <> Тип("Число") Тогда
            ВызватьИсключение "Год выпуска должен быть числом.";
        КонецЕсли;
        Объект.ГодВыпуска = Значение;
    КонецЕсли;
    Если Данные.Свойство("vin", Значение) Тогда
        Если Значение = Неопределено Тогда
            Значение = "";
        КонецЕсли;
        Если ТипЗнч(Значение) <> Тип("Строка") Тогда
            ВызватьИсключение "Некорректный VIN.";
        КонецЕсли;
        Объект.VIN = Значение;
    КонецЕсли;
    Если Данные.Свойство("photoBase64", Значение) Тогда
        MIME = Неопределено;
        Если НЕ Данные.Свойство("photoMime", MIME)
            Или (MIME <> "image/jpeg" И MIME <> "image/png" И MIME <> "image/webp") Тогда
            ВызватьИсключение "Недопустимый формат фотографии.";
        КонецЕсли;
        Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) > 2800000 Тогда
            ВызватьИсключение "Слишком большая фотография.";
        КонецЕсли;
        ДанныеФото = Base64Значение(Значение);
        Если ДанныеФото.Размер() > 2097152 Тогда
            ВызватьИсключение "Фотография превышает 2 МиБ.";
        КонецЕсли;
        Объект.Фото = Новый ХранилищеЗначения(ДанныеФото);
        Объект.ФорматФото = MIME;
    КонецЕсли;
    Если Данные.Свойство("plate_number", Значение) Тогда
        Если Значение = Неопределено Тогда
            Значение = "";
        КонецЕсли;
        Если ТипЗнч(Значение) <> Тип("Строка") Тогда
            ВызватьИсключение "Некорректный государственный номер.";
        КонецЕсли;
        Объект.ГосНомер = Значение;
    КонецЕсли;
КонецПроцедуры

Функция CarsPost(Запрос)
    Попытка
        Если СтрДлина(Запрос.ПолучитьТелоКакСтроку()) > 3000000 Тогда
            Возврат JSONОшибка(400, "payload_too_large", "Слишком большой запрос.");
        КонецЕсли;
        Данные = ПрочитатьТело(Запрос);
        Если НЕ Данные.Свойство("ownerId") Или НЕ Данные.Свойство("brand") Тогда
            Возврат JSONОшибка(400, "missing_fields", "Не заполнены обязательные поля.");
        КонецЕсли;
        Объект = Справочники.Автомобили.СоздатьЭлемент();
        АвтоПрименитьJSON(Объект, Данные, Истина);
        Объект.Записать();
        Возврат JSONОтвет(201, АвтоJSON(Объект.Ссылка));
    Исключение
        Возврат JSONОшибка(400, "invalid_car", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
КонецФункции

Функция CarByIdPatch(Запрос)
    Попытка
        Данные = ПрочитатьТело(Запрос);
        Если Данные.Свойство("ownerId") Или Данные.Свойство("status")
            Или Данные.Свойство("is_archived") Тогда
            Возврат JSONОшибка(400, "read_only", "Владельца или статус нельзя изменить через PATCH.");
        КонецЕсли;
        Ссылка = АвтоПолучитьСсылку("Автомобили", Запрос.ПараметрыURL["id"]);
        Объект = Ссылка.ПолучитьОбъект();
        Если Объект.ВАрхиве Тогда
            Возврат JSONОшибка(400, "car_archived", "Архивный автомобиль нельзя редактировать.");
        КонецЕсли;
        АвтоПрименитьJSON(Объект, Данные, Ложь);
        Объект.Записать();
        Возврат JSONОтвет(200, АвтоJSON(Ссылка));
    Исключение
        Возврат JSONОшибка(400, "invalid_car", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
КонецФункции

