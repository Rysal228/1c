
Функция UserProfileGetProfile(Запрос) 
	
	Ответ = Новый HTTPСервисОтвет(200);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	
	Результат = НОвый Структура("result", "ok");
	ЗаписатьJSON(ЗаписьJSON, Результат);
	ТелоОтвета = ЗаписьJSON.Закрыть();
	
	Ответ.УстановитьТелоИзСтроки(ТелоОтвета);
	
	Возврат Ответ;  
	
КонецФункции

Функция UserPostUser(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	
    Ответ.Заголовки.Вставить(
        "Content-Type",
        "application/json; charset=utf-8"
    );

    Попытка
        ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();

        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
        Данные = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();

        Если ТипЗнч(Данные) <> Тип("Структура") Тогда
            ВызватьИсключение "Тело запроса должно быть JSON-объектом.";
        КонецЕсли;

        Если НЕ Данные.Свойство("externalId")
            Или НЕ Данные.Свойство("phone")
            Или НЕ Данные.Свойство("firstName")
            Или НЕ Данные.Свойство("lastName") Тогда

            ВызватьИсключение
                "Обязательные поля: externalId, phone, firstName, lastName.";
        КонецЕсли;

        Если ПустаяСтрока(Данные.externalId)
            Или ПустаяСтрока(Данные.phone)
            Или ПустаяСтрока(Данные.firstName)
            Или ПустаяСтрока(Данные.lastName) Тогда

            ВызватьИсключение
                "Обязательные поля не должны быть пустыми.";
        КонецЕсли;

        СсылкаПоUUID = Справочники.ПользователиПриложения
            .НайтиПоРеквизиту(
                "ИдентификаторВнешний",
                Данные.externalId
            );

        Если НЕ СсылкаПоUUID.Пустая() Тогда
            ВызватьИсключение
                "Пользователь с таким externalId уже существует.";
        КонецЕсли;

        СсылкаПоТелефону = Справочники.ПользователиПриложения
            .НайтиПоРеквизиту("Телефон", Данные.phone);

        Если НЕ СсылкаПоТелефону.Пустая() Тогда
            ВызватьИсключение
                "Пользователь с таким телефоном уже существует.";
        КонецЕсли;

        Пользователь = Справочники.ПользователиПриложения
            .СоздатьЭлемент();

        Пользователь.ИдентификаторВнешний = Данные.externalId;
        Пользователь.Телефон = Данные.phone;
        Пользователь.Имя = Данные.firstName;
        Пользователь.Фамилия = Данные.lastName;

        Если Данные.Свойство("patronymic")
            И Данные.patronymic <> Неопределено Тогда
            Пользователь.Отчество = Данные.patronymic;
        КонецЕсли;

        Если Данные.Свойство("messengerUserId")
            И Данные.messengerUserId <> Неопределено Тогда
            Пользователь.ИдентификаторMAX = Данные.messengerUserId;
        КонецЕсли;

        Если Данные.Свойство("birthday")
            И Данные.birthday <> Неопределено
            И НЕ ПустаяСтрока(Данные.birthday) Тогда

            Пользователь.ДатаРождения =
                Дата(
                    Число(Лев(Данные.birthday, 4)),
                    Число(Сред(Данные.birthday, 6, 2)),
                    Число(Сред(Данные.birthday, 9, 2))
                );

        КонецЕсли;

        Пользователь.Активен = Истина;

        Пользователь.Наименование =
            Данные.lastName + " " + Данные.firstName;

        Пользователь.Записать();

        Результат = Новый Структура;
        Результат.Вставить("code", "ok");
        Результат.Вставить("message", "Пользователь создан.");
        Результат.Вставить(
            "externalId",
            Пользователь.ИдентификаторВнешний
        );

        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, Результат);
        ТелоОтвета = ЗаписьJSON.Закрыть();

        Ответ.УстановитьТелоИзСтроки(
            ТелоОтвета,
            КодировкаТекста.UTF8
        );

    Исключение
        Ответ.КодСостояния = 400;

        Ошибка = Новый Структура;
        Ошибка.Вставить("code", "invalid_request");
        Ошибка.Вставить("message", ОписаниеОшибки());

        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, Ошибка);
        ТелоОтвета = ЗаписьJSON.Закрыть();

        Ответ.УстановитьТелоИзСтроки(
            ТелоОтвета,
            КодировкаТекста.UTF8
        );
    КонецПопытки;

    Возврат Ответ;
КонецФункции
