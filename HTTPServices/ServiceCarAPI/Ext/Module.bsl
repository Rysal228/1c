Функция OrderPaymentStatusesGet(Запрос)
    Попытка
        Автор = ЗаказАвтор(Запрос);
        Возврат JSONОтвет(200, ЗаказСписокСтатусов("СтатусыОплаты"));
    Исключение
        Возврат JSONОшибка(400, "payment_statuses_unavailable", ОписаниеОшибки());
    КонецПопытки;
КонецФункции

// Время в хранилище — целые минуты от полуночи; HTTP использует HH:MM.
Функция ЗаказВремя(Минуты)
    Часы = Цел(Минуты / 60);
    М = Минуты - Часы * 60;
    Возврат Прав("0" + Строка(Часы), 2) + ":" + Прав("0" + Строка(М), 2);
КонецФункции

Функция ЗаказДатаСтрокой(Значение)
    Возврат Формат(Значение, "ДФ=yyyy-MM-dd");
КонецФункции

Функция ЗаказДатаВремяСтрокой(Значение)
    Если НЕ ЗначениеЗаполнено(Значение) Тогда
        Возврат Неопределено;
    КонецЕсли;
    // Время сервиса: Asia/Krasnoyarsk (+07:00); проверить зону 1С и Django.
    Возврат Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss") + "+07:00";
КонецФункции

Функция ЗаказРазобратьДату(Текст, СоВременем = Ложь)
    Если ТипЗнч(Текст) <> Тип("Строка") Тогда
        ВызватьИсключение "Дата должна быть строкой.";
    КонецЕсли;
    Если СтрДлина(Текст) < 10 Или Сред(Текст,5,1) <> "-" Или Сред(Текст,8,1) <> "-" Тогда
        ВызватьИсключение "Ожидается дата YYYY-MM-DD.";
    КонецЕсли;
    Попытка
        Год = Число(Лев(Текст,4));
        Месяц = Число(Сред(Текст,6,2));
        День = Число(Сред(Текст,9,2));
        Если СоВременем Тогда
            Если СтрДлина(Текст) < 19 Или Сред(Текст,11,1) <> "T" Тогда
                ВызватьИсключение "Ожидается дата-время ISO-8601.";
            КонецЕсли;
            Если Сред(Текст,14,1) <> ":" Или Сред(Текст,17,1) <> ":" Тогда
                ВызватьИсключение "Некорректный формат времени.";
            КонецЕсли;
            Если СтрДлина(Текст) > 19 И Сред(Текст,20) <> "+07:00" Тогда
                ВызватьИсключение "Ожидается часовой пояс +07:00.";
            КонецЕсли;
            Результат = Дата(Год, Месяц, День,
                Число(Сред(Текст,12,2)), Число(Сред(Текст,15,2)),
                Число(Сред(Текст,18,2)));
            Если ЗаказДатаВремяСтрокой(Результат) <> Лев(Текст,19) + "+07:00" Тогда
                ВызватьИсключение "Некорректная дата-время.";
            КонецЕсли;
            Возврат Результат;
        КонецЕсли;
        Если СтрДлина(Текст) <> 10 Тогда
            ВызватьИсключение "Ожидается YYYY-MM-DD.";
        КонецЕсли;
        Результат = Дата(Год, Месяц, День);
        Если ЗаказДатаСтрокой(Результат) <> Текст Тогда
            ВызватьИсключение "Некорректная календарная дата.";
        КонецЕсли;
        Возврат Результат;
    Исключение
        ВызватьИсключение "Некорректное значение даты: " + Текст;
    КонецПопытки;
КонецФункции

Функция ЗаказНастройкиЗаписи()
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ ДлительностьМинут, ИнтервалМинут "
        + "ИЗ РегистрСведений.НастройкиЗаписи ГДЕ Ключ = &Ключ";
    З.УстановитьПараметр("Ключ", "main");
    В = З.Выполнить().Выбрать();
    Если НЕ В.Следующий() Тогда
        ВызватьИсключение "Заполните регистр НастройкиЗаписи с ключом main.";
    КонецЕсли;
    Если В.ДлительностьМинут < 5 Или В.ДлительностьМинут > 1440
        Или В.ИнтервалМинут < 5 Или В.ИнтервалМинут > В.ДлительностьМинут Тогда
        ВызватьИсключение "Некорректные длительность и интервал записи.";
    КонецЕсли;
    Возврат Новый Структура("Длительность,Интервал",
        В.ДлительностьМинут, В.ИнтервалМинут);
КонецФункции

Функция ЗаказГрафикДня(ДатаДня)
    День = ДеньНедели(ДатаДня) - 1; // 1С: пн=1; внешний API: пн=0
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Рабочий, НачалоМинут, КонецМинут "
        + "ИЗ РегистрСведений.НедельныйГрафик ГДЕ ДеньНедели = &День";
    З.УстановитьПараметр("День", День);
    В = З.Выполнить().Выбрать();
    Если НЕ В.Следующий() Тогда
        Возврат Новый Структура("Рабочий,Начало,Конец", Ложь, 0, 0);
    КонецЕсли;
    Если В.Рабочий И (В.НачалоМинут < 0
        Или В.КонецМинут > 1440 Или В.НачалоМинут >= В.КонецМинут) Тогда
        ВызватьИсключение "Некорректный интервал недельного графика.";
    КонецЕсли;
    Возврат Новый Структура("Рабочий,Начало,Конец",
        В.Рабочий, В.НачалоМинут, В.КонецМинут);
КонецФункции

Функция ЗаказИнтервалыДня(ДатаДня, ИмяРегистра)
    Если ИмяРегистра <> "БлокировкиЗаписи" И ИмяРегистра <> "ЗанятыеИнтервалы" Тогда
        ВызватьИсключение "Недопустимый регистр календаря.";
    КонецЕсли;
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ НачалоМинут, КонецМинут ИЗ РегистрСведений."
        + ИмяРегистра + " ГДЕ Дата = &Дата УПОРЯДОЧИТЬ ПО НачалоМинут";
    З.УстановитьПараметр("Дата", ДатаДня);
    Результат = Новый Массив;
    В = З.Выполнить().Выбрать();
    Пока В.Следующий() Цикл
        Результат.Добавить(Новый Структура("Начало,Конец",
            В.НачалоМинут, В.КонецМинут));
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ЗаказПересекается(Начало, Конец, Интервалы)
    Для Каждого Интервал Из Интервалы Цикл
        Если Начало < Интервал.Конец
            И Конец > Интервал.Начало Тогда
            Возврат Истина;
        КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции
	
Функция ЗаказИнтервалыJSON(Интервалы)
    МассивJSON = Новый Массив;
    Для Каждого Интервал Из Интервалы Цикл
        МассивJSON.Добавить(Новый Структура(
            "from,to",
            ЗаказВремя(Интервал.Начало),
            ЗаказВремя(Интервал.Конец)
        ));
    КонецЦикла;
    Возврат МассивJSON;
КонецФункции

Функция ЗаказДоступностьДня(ДатаДня)
    Параметры = ЗаказНастройкиЗаписи();
    График = ЗаказГрафикДня(ДатаДня);
    Результат = Новый Структура;
    Результат.Вставить("date", ЗаказДатаСтрокой(ДатаДня));
    Результат.Вставить("dayType", ?(График.Рабочий, "working", "nonWorking"));
    Результат.Вставить("workingHours", Неопределено);
    Результат.Вставить("appointmentDuration", Параметры.Длительность);
    Результат.Вставить("slotInterval", Параметры.Интервал);
    Результат.Вставить("availableSlots", Новый Массив);
    Результат.Вставить("busySlots", Новый Массив);
    Результат.Вставить("blockedSlots", Новый Массив);
    Если НЕ График.Рабочий Тогда
        Возврат Результат;
    КонецЕсли;
    Результат.Вставить("workingHours",
        Новый Структура("from,to", ЗаказВремя(График.Начало), ЗаказВремя(График.Конец)));
    Блоки = ЗаказИнтервалыДня(ДатаДня, "БлокировкиЗаписи");
    Занято = ЗаказИнтервалыДня(ДатаДня, "ЗанятыеИнтервалы");
    Результат.Вставить("blockedSlots", ЗаказИнтервалыJSON(Блоки));
    Результат.Вставить("busySlots", ЗаказИнтервалыJSON(Занято));
    Начало = График.Начало;
    Пока Начало + Параметры.Длительность <= График.Конец Цикл
        Момент = ДатаДня + Начало * 60;
        Если Момент > ТекущаяДата()
            И НЕ ЗаказПересекается(Начало, Начало + Параметры.Длительность, Блоки)
            И НЕ ЗаказПересекается(Начало, Начало + Параметры.Длительность, Занято) Тогда
            Результат.availableSlots.Добавить(ЗаказВремя(Начало));
        КонецЕсли;
        Начало = Начало + Параметры.Интервал;
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция OrderScheduleGet(Запрос)
    Попытка
        Автор = ЗаказАвтор(Запрос);
        Параметры = ЗаказНастройкиЗаписи();
        НастройкиJSON = Новый Структура("appointmentDuration,slotInterval",
            Параметры.Длительность, Параметры.Интервал);
        Дни = Новый Массив;
        Названия = Новый Массив;
        Для Каждого Имя Из СтрРазделить(
            "Понедельник,Вторник,Среда,Четверг,Пятница,Суббота,Воскресенье", ",") Цикл
            Названия.Добавить(Имя);
        КонецЦикла;
        Для День = 0 По 6 Цикл
            З = Новый Запрос;
            З.Текст = "ВЫБРАТЬ Рабочий, НачалоМинут, КонецМинут "
                + "ИЗ РегистрСведений.НедельныйГрафик ГДЕ ДеньНедели = &День";
            З.УстановитьПараметр("День", День);
            В = З.Выполнить().Выбрать();
            Рабочий = Ложь;
            НачалоВремени = Неопределено;
            КонецВремени = Неопределено;
            Если В.Следующий() Тогда
                Рабочий = В.Рабочий;
                Если Рабочий Тогда
                    НачалоВремени = ЗаказВремя(В.НачалоМинут);
                    КонецВремени = ЗаказВремя(В.КонецМинут);
                КонецЕсли;
            КонецЕсли;
            ДеньJSON = Новый Структура;
            ДеньJSON.Вставить("weekday", День);
            ДеньJSON.Вставить("weekdayName", Названия[День]);
            ДеньJSON.Вставить("is_working", Рабочий);
            ДеньJSON.Вставить("startTime", НачалоВремени);
            ДеньJSON.Вставить("endTime", КонецВремени);
            Дни.Добавить(ДеньJSON);
        КонецЦикла;
        З = Новый Запрос;
        З.Текст = "ВЫБРАТЬ Дата, НачалоМинут, КонецМинут "
            + "ИЗ РегистрСведений.БлокировкиЗаписи "
            + "УПОРЯДОЧИТЬ ПО Дата, НачалоМинут";
        В = З.Выполнить().Выбрать();
        Блоки = Новый Массив;
        Пока В.Следующий() Цикл
            Блоки.Добавить(Новый Структура("date,startTime,endTime",
                ЗаказДатаСтрокой(В.Дата),
                ЗаказВремя(В.НачалоМинут), ЗаказВремя(В.КонецМинут)));
        КонецЦикла;
        Возврат JSONОтвет(200,
            Новый Структура("settings,weekdays,blocks", НастройкиJSON, Дни, Блоки));
    Исключение
        Возврат JSONОшибка(400, "schedule_unavailable", ОписаниеОшибки());
    КонецПопытки;
КонецФункции

Функция OrderAvailabilityGet(Запрос)
    Попытка
        Автор = ЗаказАвтор(Запрос);
        ДатаДня = ЗаказРазобратьДату(ЗаказПараметр(Запрос, "date"));
        Возврат JSONОтвет(200, ЗаказДоступностьДня(ДатаДня));
    Исключение
        Возврат JSONОшибка(400, "availability_unavailable", ОписаниеОшибки());
    КонецПопытки;
КонецФункции


// ===== ЧТЕНИЕ ЗАКАЗОВ И РАЗГРАНИЧЕНИЕ ДОСТУПА =====

Функция ЗаказДокументСсылка(ИД)
    Ссылка = Документы.ЗаказыНаОбслуживание.ПолучитьСсылку(АвтоUUIDСтрокой(ИД));
    Объект = Ссылка.ПолучитьОбъект();
    Если Объект = Неопределено Или Объект.ПометкаУдаления Тогда
        ВызватьИсключение "Заказ не найден.";
    КонецЕсли;
    Возврат Ссылка;
КонецФункции

Процедура ЗаказПроверитьВидимость(Объект, Автор)
    Если Автор.Код = "user" И Объект.Клиент <> Автор.Ссылка Тогда
        ВызватьИсключение "Заказ не найден или недоступен.";
    КонецЕсли;
    // Соответствует текущему Django: специалист видит все заказы,
    // но не может редактировать статусы/цены и не получает цены в JSON.
КонецПроцедуры

Функция ЗаказРазрешения(Объект, Автор)
    Свой = Объект.Клиент = Автор.Ссылка;
    Менеджер = ЗаказМенеджер(Автор);
    Начальный = Объект.СтатусЗаказа.КодСтатуса = "under_review";
    Ожидает = Объект.СтатусРабот.КодСтатуса = "waiting_manager_review";
    Завершен = Объект.СтатусЗаказа.КодСтатуса = "completed";
    ПравоКлиента = Автор.Код = "user" И Свой И Начальный И Ожидает;
    ПравоМенеджера = Менеджер И НЕ Завершен;
    Результат = Новый Структура;
    Результат.Вставить("canTransitionStatus", Менеджер);
    Результат.Вставить("canTransitionWorkStatus", Менеджер);
    Результат.Вставить("canEditWorks", ПравоКлиента Или ПравоМенеджера);
    Результат.Вставить("canEditPrice", ПравоМенеджера);
    Результат.Вставить("canEditAppointment", ПравоКлиента Или ПравоМенеджера);
    Результат.Вставить("canAssignMechanics", ПравоМенеджера);
    Результат.Вставить("canEditDescription", ПравоКлиента Или ПравоМенеджера);
    Результат.Вставить("canChangePaymentStatus", Менеджер);
    Возврат Результат;
КонецФункции

Функция ЗаказJSON(Объект, Автор)
    ЗаказПроверитьВидимость(Объект, Автор);
    Данные = Новый Структура;
    Данные.Вставить("id", Строка(Объект.Ссылка.УникальныйИдентификатор()));
    Данные.Вставить("orderNumber", Объект.Номер);
    Данные.Вставить("car", Строка(Объект.Автомобиль.УникальныйИдентификатор()));
    Данные.Вставить("carName", СокрЛП(Объект.МаркаСнимок + " " + Объект.МодельСнимок));
    Если Автор.Код <> "user" Тогда
        Данные.Вставить("ownerPhone", Объект.ТелефонКлиентаСнимок);
    КонецЕсли;
    Данные.Вставить("carYear", Объект.ГодВыпускаСнимок);
    Данные.Вставить("carVin", Объект.VINСнимок);
    Данные.Вставить("carPlateNumber", Объект.ГосНомерСнимок);
    Данные.Вставить("status", ЗаказСтатусJSON(Объект.СтатусЗаказа));
    Данные.Вставить("workStatus", ЗаказСтатусJSON(Объект.СтатусРабот));
    Данные.Вставить("paymentStatus", ЗаказСтатусJSON(Объект.СтатусОплаты));
    Данные.Вставить("appointmentAt", ЗаказДатаВремяСтрокой(Объект.ДатаЗаписи));
    Данные.Вставить("description", Объект.Описание);
    Данные.Вставить("refusalReason", Объект.ПричинаОтказа);
    Данные.Вставить("createdAt", ЗаказДатаВремяСтрокой(Объект.Дата));
    Данные.Вставить("permissions", ЗаказРазрешения(Объект, Автор));
    РаботыJSON = Новый Массив;
    Сумма = 0;
    Для Каждого СтрокаРаботы Из Объект.Работы Цикл
        Если СтрокаРаботы.ВидРабот.Пустая() Тогда
            Продолжить;
        КонецЕсли;
        ДанныеРаботы = Новый Структура;
        ДанныеРаботы.Вставить("id", СтрокаРаботы.ИдентификаторСтроки);
        ДанныеРаботы.Вставить("workTypeId",
            Строка(СтрокаРаботы.ВидРабот.УникальныйИдентификатор()));
        ДанныеРаботы.Вставить("name", СтрокаРаботы.ВидРабот.Наименование);
        Если Автор.Код <> "mechanic" Тогда
            ДанныеРаботы.Вставить("price", СтрокаРаботы.Цена);
        КонецЕсли;
        РаботыJSON.Добавить(ДанныеРаботы);
        Сумма = Сумма + СтрокаРаботы.Цена;
    КонецЦикла;
    Данные.Вставить("works", РаботыJSON);
    Если Автор.Код <> "mechanic" Тогда
        Данные.Вставить("price", Сумма);
    КонецЕсли;
    Специалисты = Новый Массив;
    Для Каждого СтрокаСпециалиста Из Объект.Специалисты Цикл
        Если НЕ СтрокаСпециалиста.Специалист.Пустая() Тогда
            Специалисты.Добавить(Строка(
                СтрокаСпециалиста.Специалист.УникальныйИдентификатор()));
        КонецЕсли;
    КонецЦикла;
    Данные.Вставить("mechanics", Специалисты);
    Возврат Данные;
КонецФункции

Функция ЗаказСовпадаетФильтрам(Объект, Запрос, Автор)
    Значение = ЗаказПараметр(Запрос, "car");
    Если НЕ ПустаяСтрока(Значение) И
        Строка(Объект.Автомобиль.УникальныйИдентификатор()) <> Значение Тогда
        Возврат Ложь;
    КонецЕсли;
    Значение = ЗаказПараметр(Запрос, "order_number");
    Если НЕ ПустаяСтрока(Значение)
        И Найти(НРег(Объект.Номер), НРег(Значение)) = 0 Тогда
        Возврат Ложь;
    КонецЕсли;
    Значение = ЗаказПараметр(Запрос, "vin");
    Если НЕ ПустаяСтрока(Значение)
        И Найти(НРег(Объект.VINСнимок), НРег(Значение)) = 0 Тогда
        Возврат Ложь;
    КонецЕсли;
    Значение = ЗаказПараметр(Запрос, "plate_number");
    Если НЕ ПустаяСтрока(Значение)
        И Найти(НРег(Объект.ГосНомерСнимок), НРег(Значение)) = 0 Тогда
        Возврат Ложь;
    КонецЕсли;
    Значение = ЗаказПараметр(Запрос, "brand");
    Если НЕ ПустаяСтрока(Значение) И
        Строка(Объект.МаркаАвтомобиля.УникальныйИдентификатор()) <> Значение Тогда
        Возврат Ложь;
    КонецЕсли;
    Значение = ЗаказПараметр(Запрос, "model");
    Если НЕ ПустаяСтрока(Значение) И
        Строка(Объект.МодельАвтомобиля.УникальныйИдентификатор()) <> Значение Тогда
        Возврат Ложь;
    КонецЕсли;
    Значение = ЗаказПараметр(Запрос, "status");
    Если НЕ ПустаяСтрока(Значение) И
        Строка(Объект.СтатусЗаказа.УникальныйИдентификатор()) <> Значение Тогда
        Возврат Ложь;
    КонецЕсли;
    Значение = ЗаказПараметр(Запрос, "work_status");
    Если НЕ ПустаяСтрока(Значение) И
        Строка(Объект.СтатусРабот.УникальныйИдентификатор()) <> Значение Тогда
        Возврат Ложь;
    КонецЕсли;
    Значение = ЗаказПараметр(Запрос, "work_type");
    Если НЕ ПустаяСтрока(Значение) Тогда
        Найдено = Ложь;
        Для Каждого СтрокаРаботы Из Объект.Работы Цикл
            Если НЕ СтрокаРаботы.ВидРабот.Пустая()
                И Строка(СтрокаРаботы.ВидРабот.УникальныйИдентификатор()) = Значение Тогда
                Найдено = Истина;
                Прервать;
            КонецЕсли;
        КонецЦикла;
        Если НЕ Найдено Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЕсли;
    Значение = ЗаказПараметр(Запрос, "date_from");
    Если НЕ ПустаяСтрока(Значение) Тогда
        Если НЕ ЗначениеЗаполнено(Объект.ДатаЗаписи) Или
            НачалоДня(Объект.ДатаЗаписи) < ЗаказРазобратьДату(Значение) Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЕсли;
    Значение = ЗаказПараметр(Запрос, "date_to");
    Если НЕ ПустаяСтрока(Значение) Тогда
        Если НЕ ЗначениеЗаполнено(Объект.ДатаЗаписи) Или
            НачалоДня(Объект.ДатаЗаписи) > ЗаказРазобратьДату(Значение) Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЕсли;
    Значение = НРег(ЗаказПараметр(Запрос, "search"));
    Если НЕ ПустаяСтрока(Значение) Тогда
        Совпало = Найти(НРег(Объект.МаркаСнимок), Значение) > 0
            Или Найти(НРег(Объект.МодельСнимок), Значение) > 0
            Или Найти(НРег(Объект.Описание), Значение) > 0;
        Если Автор.Код <> "user" Тогда
            Совпало = Совпало
                Или Найти(НРег(Объект.ТелефонКлиентаСнимок), Значение) > 0
                Или Найти(НРег(Объект.ФиоКлиентаСнимок), Значение) > 0;
        КонецЕсли;
        Для Каждого СтрокаРаботы Из Объект.Работы Цикл
            Если НЕ СтрокаРаботы.ВидРабот.Пустая() Тогда
                Совпало = Совпало
                    Или Найти(НРег(СтрокаРаботы.ВидРабот.Наименование), Значение) > 0;
            КонецЕсли;
        КонецЦикла;
        Если НЕ Совпало Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЕсли;
    Возврат Истина;
КонецФункции

Функция ЗаказСписок(Запрос, Автор)
    З = Новый Запрос;
    З.Текст = "ВЫБРАТЬ Ссылка ИЗ Документ.ЗаказыНаОбслуживание "
        + "ГДЕ НЕ ПометкаУдаления";
    Если Автор.Код = "user" Тогда
        З.Текст = З.Текст + " И Клиент = &Клиент";
        З.УстановитьПараметр("Клиент", Автор.Ссылка);
    КонецЕсли;
    З.Текст = З.Текст + " УПОРЯДОЧИТЬ ПО Дата УБЫВ";
    В = З.Выполнить().Выбрать();
    Результат = Новый Массив;
    Пока В.Следующий() Цикл
        Объект = В.Ссылка.ПолучитьОбъект();
        Если Объект <> Неопределено
            И ЗаказСовпадаетФильтрам(Объект, Запрос, Автор) Тогда
            Результат.Добавить(ЗаказJSON(Объект, Автор));
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция OrdersGet(Запрос)
    Попытка
        Автор = ЗаказАвтор(Запрос);
        Возврат JSONОтвет(200, ЗаказСписок(Запрос, Автор));
    Исключение
        Возврат JSONОшибка(400, "orders_unavailable", ОписаниеОшибки());
    КонецПопытки;
КонецФункции

