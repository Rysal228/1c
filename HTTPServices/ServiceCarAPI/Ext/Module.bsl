Функция UserListMechanics(Запрос)
    Попытка
        Поиск = Запрос.ПараметрыЗапроса.Получить("search");
        СписокИД = Запрос.ПараметрыЗапроса.Получить("ids");

        Если Поиск = Неопределено Тогда
            Поиск = "";
        КонецЕсли;
        Если СписокИД = Неопределено Тогда
            СписокИД = "";
        КонецЕсли;

        Поиск = СокрЛП(Поиск);
        СписокИД = СокрЛП(СписокИД);
        Если СтрДлина(Поиск) > 150 Или СтрДлина(СписокИД) > 4000 Тогда
            Возврат JSONОшибка(400, "invalid_search", "Слишком длинный поисковый запрос.");
        КонецЕсли;

        Идентификаторы = Новый Массив;
        Для Каждого ИД Из СтрРазделить(СписокИД, ",", Ложь) Цикл
            ИД = НРег(СокрЛП(ИД));
            Если НЕ ПустаяСтрока(ИД) И Идентификаторы.Найти(ИД) = Неопределено Тогда
                Идентификаторы.Добавить(ИД);
            КонецЕсли;
        КонецЦикла;

        Результат = Новый Массив;
        // Не раскрываем полный список специалистов без search / ids.
        Если ПустаяСтрока(Поиск) И Идентификаторы.Количество() = 0 Тогда
            Возврат JSONОтвет(200, Результат);
        КонецЕсли;

        ЗапросДанных = Новый Запрос;
        ЗапросДанных.Текст =
            "ВЫБРАТЬ РАЗЛИЧНЫЕ
            |   Пользователи.ИдентификаторВнешний КАК ИдентификаторВнешний,
            |   Пользователи.Телефон КАК Телефон,
            |   Пользователи.Имя КАК Имя,
            |   Пользователи.Фамилия КАК Фамилия,
            |   Пользователи.Отчество КАК Отчество,
            |   Пользователи.ДатаРождения КАК ДатаРождения
            |ИЗ
            |   Справочник.ПользователиПриложения КАК Пользователи
            |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РолиПользователей КАК Назначения
            |       ПО Назначения.Пользователь = Пользователи.Ссылка
            |ГДЕ
            |   НЕ Пользователи.ПометкаУдаления
            |   И Назначения.Роль = &Роль
            |УПОРЯДОЧИТЬ ПО
            |   Фамилия, Имя, Отчество";
        ЗапросДанных.УстановитьПараметр("Роль", Перечисления.РолиПользователей.Специалист);

        Выборка = ЗапросДанных.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            СовпалоПоИД = Идентификаторы.Найти(
                НРег(Выборка.ИдентификаторВнешний)) <> Неопределено;
            СовпалоПоПоиску = СовпадаетПоискСпециалиста(Выборка, Поиск);
            Если НЕ СовпалоПоИД И НЕ СовпалоПоПоиску Тогда
                Продолжить;
            КонецЕсли;

            Пользователь = Новый Структура;
            Пользователь.Вставить("id", Выборка.ИдентификаторВнешний);
            Пользователь.Вставить("phone", Выборка.Телефон);
            Пользователь.Вставить("firstName", Выборка.Имя);
            Пользователь.Вставить("lastName", Выборка.Фамилия);
            Пользователь.Вставить("patronymic", Выборка.Отчество);
            ДеньРождения = Неопределено;
            Если ЗначениеЗаполнено(Выборка.ДатаРождения) Тогда
                ДеньРождения = Формат(Выборка.ДатаРождения, "ДФ=yyyy-MM-dd");
            КонецЕсли;
            Пользователь.Вставить("birthday", ДеньРождения);
            Результат.Добавить(Пользователь);

            Если Результат.Количество() >= 20 Тогда
                Прервать;
            КонецЕсли;
        КонецЦикла;
        Возврат JSONОтвет(200, Результат);
    Исключение
        ЗаписьЖурналаРегистрации("ServiceCarAPI.СписокСпециалистов",
            УровеньЖурналаРегистрации.Ошибка, , ,
            ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
        Возврат JSONОшибка(500, "onec_list_failed", "Не удалось получить список специалистов.");
    КонецПопытки;
КонецФункции

Функция UserGetByOneCId(Запрос)
    ТекстИД = СокрЛП(Запрос.ПараметрыURL["id"]);
    Попытка
        ИД = Новый УникальныйИдентификатор(ТекстИД);
    Исключение
        Возврат JSONОшибка(400, "invalid_onec_id", "Некорректный идентификатор 1С.");
