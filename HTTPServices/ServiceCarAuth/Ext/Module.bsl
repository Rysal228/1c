
Функция ОтветJSON(КодСостояния, Данные)
    Ответ = Новый HTTPСервисОтвет(КодСостояния);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Ответ.Заголовки.Вставить("Cache-Control", "no-store");
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8);
    Возврат Ответ;
КонецФункции

Функция ОшибкаСервиса(КодСостояния)
    Данные = Новый Структура("error", "authentication_service_unavailable");
    Возврат ОтветJSON(КодСостояния, Данные);
КонецФункции

Функция ОтказВПароле()
    Данные = Новый Структура("authenticated", Ложь);
    Возврат ОтветJSON(200, Данные);
КонецФункции

Функция ВызванОтИмениТехническогоПользователя(Запрос)
    Заголовок = Запрос.Заголовки.Получить("Authorization");
    Если ТипЗнч(Заголовок) <> Тип("Строка")
        Или Лев(Заголовок, 6) <> "Basic " Тогда
        Возврат Ложь;
    КонецЕсли;

    ТекущийПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если ТекущийПользовательИБ = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат ТекущийПользовательИБ.Имя = "servicecar-auth";
КонецФункции

Функция НормализоватьТелефонАвторизации(Телефон)
    Если ТипЗнч(Телефон) <> Тип("Строка") Тогда
        Возврат "";
    КонецЕсли;

    Телефон = СокрЛП(Телефон);
    Если Лев(Телефон, 1) = "+" Тогда
        Телефон = Сред(Телефон, 2);
    КонецЕсли;

    Если СтрДлина(Телефон) <> 11 Или Лев(Телефон, 1) <> "7" Тогда
        Возврат "";
    КонецЕсли;

    Для Позиция = 1 По 11 Цикл
        Если Найти("0123456789", Сред(Телефон, Позиция, 1)) = 0 Тогда
            Возврат "";
        КонецЕсли;
    КонецЦикла;

    Возврат Телефон;
КонецФункции

Функция ПолучитьРолиАвторизации(СсылкаПользователя)
    ЗапросДанных = Новый Запрос;
    ЗапросДанных.Текст =
        "ВЫБРАТЬ Роль ИЗ РегистрСведений.РолиПользователей "
        + "ГДЕ Пользователь = &Пользователь";
    ЗапросДанных.УстановитьПараметр("Пользователь", СсылкаПользователя);
    Выборка = ЗапросДанных.Выполнить().Выбрать();

    Роли = Новый Массив;
    Пока Выборка.Следующий() Цикл
        Код = "";
        Если Выборка.Роль = Перечисления.РолиПользователей.Пользователь Тогда
            Код = "user";
        ИначеЕсли Выборка.Роль = Перечисления.РолиПользователей.Специалист Тогда
            Код = "mechanic";
        ИначеЕсли Выборка.Роль = Перечисления.РолиПользователей.Менеджер Тогда
            Код = "admin";
        КонецЕсли;
        Если НЕ ПустаяСтрока(Код) И Роли.Найти(Код) = Неопределено Тогда
            Роли.Добавить(Код);
        КонецЕсли;
    КонецЦикла;
    Возврат Роли;
КонецФункции

Функция СовпадаетПарольПользователя(Ссылка, Пароль)
    Набор = РегистрыСведений.ПаролиПользователейПриложения.СоздатьНаборЗаписей();
    Набор.Отбор.Пользователь.Установить(Ссылка);
    Набор.Прочитать();
    Если Набор.Количество() <> 1 Тогда
        Возврат Ложь;
    КонецЕсли;

    Для Каждого Запись Из Набор Цикл
        Значение = Запись.СохраняемоеЗначение;
        Если ПустаяСтрока(Значение) Тогда
            Возврат Ложь;
        КонецЕсли;
        Возврат ПроверитьСоответствиеПароляПользователяСохраняемомуЗначению(
            Пароль, Значение);
    КонецЦикла;
    Возврат Ложь;
КонецФункции

Функция PasswordVerifyPost(Запрос)
    Если НЕ ВызванОтИмениТехническогоПользователя(Запрос) Тогда
        Возврат ОшибкаСервиса(403);
    КонецЕсли;

    Попытка
        Тело = Запрос.ПолучитьТелоКакСтроку();
        Если СтрДлина(Тело) > 4096 Тогда
            Возврат ОшибкаСервиса(413);
        КонецЕсли;

        Чтение = Новый ЧтениеJSON;
        Чтение.УстановитьСтроку(Тело);
        Данные = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();

        Если ТипЗнч(Данные) <> Тип("Структура") Тогда
            Возврат ОшибкаСервиса(400);
        КонецЕсли;

        Телефон = Неопределено;
        Пароль = Неопределено;
        Если НЕ Данные.Свойство("phone", Телефон)
            Или НЕ Данные.Свойство("password", Пароль) Тогда
            Возврат ОшибкаСервиса(400);
        КонецЕсли;

        Телефон = НормализоватьТелефонАвторизации(Телефон);
        Если ПустаяСтрока(Телефон)
            Или ТипЗнч(Пароль) <> Тип("Строка")
            Или СтрДлина(Пароль) < 1
            Или СтрДлина(Пароль) > 128 Тогда
            Возврат ОтказВПароле();
        КонецЕсли;

        Ссылка = Справочники.ПользователиПриложения.НайтиПоРеквизиту(
            "Телефон", Телефон);
        Если Ссылка.Пустая() Тогда
            Возврат ОтказВПароле();
        КонецЕсли;

        Пользователь = Ссылка.ПолучитьОбъект();
        Если Пользователь = Неопределено Тогда
            Возврат ОтказВПароле();
        КонецЕсли;
        Если Пользователь.ПометкаУдаления Или НЕ Пользователь.Активен Тогда
            Возврат ОтказВПароле();
        КонецЕсли;

        Если НЕ СовпадаетПарольПользователя(Ссылка, Пароль) Тогда
            Возврат ОтказВПароле();
        КонецЕсли;

        Роли = ПолучитьРолиАвторизации(Ссылка);
        Если Роли.Количество() = 0 Тогда
            Возврат ОтказВПароле();
        КонецЕсли;

        Ответ = Новый Структура;
        Ответ.Вставить("authenticated", Истина);
        Ответ.Вставить("onecId", Строка(Ссылка.УникальныйИдентификатор()));
        Ответ.Вставить("phone", Пользователь.Телефон);
        Ответ.Вставить("isActive", Истина);
        Ответ.Вставить("roles", Роли);
        Возврат ОтветJSON(200, Ответ);
    Исключение
        Возврат ОшибкаСервиса(500);
    КонецПопытки;
КонецФункции

// MAX: сюда поступают только уже проверенные Django идентификаторы и контакт.
// HTTP-сервис закрыт Basic-авторизацией технического пользователя и HTTPS.
Функция MAXОшибка(Статус, Код, Сообщение)
    Возврат ОтветJSON(Статус, Новый Структура("code,message", Код, Сообщение));
КонецФункции

Функция MAXПрочитатьЗапрос(Запрос)
    Текст = Запрос.ПолучитьТелоКакСтроку();
    Если СтрДлина(Текст) > 8192 Тогда
        ВызватьИсключение "Слишком большой запрос.";
    КонецЕсли;
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Текст);
    Данные = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Если ТипЗнч(Данные) <> Тип("Структура") Тогда
        ВызватьИсключение "Ожидается объект JSON.";
    КонецЕсли;
    Возврат Данные;
КонецФункции

Функция MAXПоле(Данные, Имя, Максимум, Обязательно = Истина)
    Значение = Неопределено;
    Если НЕ Данные.Свойство(Имя, Значение) Тогда
        Если Обязательно Тогда
            ВызватьИсключение "Отсутствует поле " + Имя;
        КонецЕсли;
        Возврат "";
    КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Строка")
        Или СтрДлина(Значение) > Максимум Тогда
        ВызватьИсключение "Некорректное поле " + Имя;
    КонецЕсли;
    Значение = СокрЛП(Значение);
    Если Обязательно И ПустаяСтрока(Значение) Тогда
        ВызватьИсключение "Пустое поле " + Имя;
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция MAXНайтиПользователяПоТелефону(Телефон)
    Возврат Справочники.ПользователиПриложения.НайтиПоРеквизиту("Телефон", Телефон);
КонецФункции

Функция MAXПрофиль(Ссылка)
    Объект = Ссылка.ПолучитьОбъект();
    Данные = Новый Структура;
    Данные.Вставить("onecId", Строка(Ссылка.УникальныйИдентификатор()));
    Данные.Вставить("externalId", Объект.ИдентификаторВнешний);
    Данные.Вставить("phone", Объект.Телефон);
    Данные.Вставить("messengerUserId", Объект.ИдентификаторMAX);
    Данные.Вставить("firstName", Объект.Имя);
    Данные.Вставить("lastName", Объект.Фамилия);
    Данные.Вставить("isActive", Объект.Активен И НЕ Объект.ПометкаУдаления);
    Данные.Вставить("roles", ПолучитьРолиАвторизации(Ссылка));
    Возврат Данные;
КонецФункции

Функция MAXДатаИзСтроки(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) <> 14 Тогда
        ВызватьИсключение "Некорректная дата кода.";
    КонецЕсли;
    Возврат Дата(Число(Лев(Значение, 4)), Число(Сред(Значение, 5, 2)),
        Число(Сред(Значение, 7, 2)), Число(Сред(Значение, 9, 2)),
        Число(Сред(Значение, 11, 2)), Число(Сред(Значение, 13, 2)));
КонецФункции

Функция MAXСостояниеКода(Ссылка)
    Набор = РегистрыСведений.КодыАвторизацииMAX.СоздатьНаборЗаписей();
    Набор.Отбор.Пользователь.Установить(Ссылка);
    Набор.Прочитать();
    Если Набор.Количество() = 0 Тогда
        Возврат Неопределено;
    КонецЕсли;
    Для Каждого Запись Из Набор Цикл
        Чтение = Новый ЧтениеJSON;
        Чтение.УстановитьСтроку(Запись.Состояние);
        Данные = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();
        Возврат Данные;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

Процедура MAXЗаписатьСостояние(Ссылка, Состояние)
    Набор = РегистрыСведений.КодыАвторизацииMAX.СоздатьНаборЗаписей();
    Набор.Отбор.Пользователь.Установить(Ссылка);
    Если Состояние <> Неопределено Тогда
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, Состояние);
        Сериализация = ЗаписьJSON.Закрыть();
        Если СтрДлина(Сериализация) > 1024 Тогда
            ВызватьИсключение "Слишком длинное состояние кода.";
        КонецЕсли;
        Запись = Набор.Добавить();
        Запись.Пользователь = Ссылка;
        Запись.Состояние = Сериализация;
    КонецЕсли;
    Набор.Записать(Истина);
КонецПроцедуры

Процедура MAXЗаблокироватьПользователей()
    Блокировка = Новый БлокировкаДанных;
    Блокировка.Добавить("Справочник.ПользователиПриложения");
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура MAXЗаблокироватьКоды()
    Блокировка = Новый БлокировкаДанных;
    Блокировка.Добавить("РегистрСведений.КодыАвторизацииMAX");
    Блокировка.Заблокировать();
КонецПроцедуры

Функция MAXResolvePost(Запрос)
    Если НЕ ВызванОтИмениТехническогоПользователя(Запрос) Тогда
        Возврат ОшибкаСервиса(403);
    КонецЕсли;
    Попытка
        Данные = MAXПрочитатьЗапрос(Запрос);
        MAXID = MAXПоле(Данные, "messengerUserId", 255);
        Если СтрДлина(MAXID) > 20 Тогда
            Возврат MAXОшибка(400, "invalid_max_id", "Некорректный ID MAX.");
        КонецЕсли;
        Для Н = 1 По СтрДлина(MAXID) Цикл
            Если Найти("0123456789", Сред(MAXID, Н, 1)) = 0 Тогда
                Возврат MAXОшибка(400, "invalid_max_id", "Некорректный ID MAX.");
            КонецЕсли;
        КонецЦикла;
        ТелефонВход = MAXПоле(Данные, "phone", 20, Ложь);
        Телефон = "";
        Если НЕ ПустаяСтрока(ТелефонВход) Тогда
            Телефон = НормализоватьТелефонАвторизации(ТелефонВход);
            Если ПустаяСтрока(Телефон) Тогда
                Возврат MAXОшибка(400, "invalid_phone", "Некорректный номер телефона.");
            КонецЕсли;
        КонецЕсли;
        ВнешнийID = MAXПоле(Данные, "externalId", 36, Ложь);
        Имя = MAXПоле(Данные, "firstName", 150, Ложь);
        Фамилия = MAXПоле(Данные, "lastName", 150, Ложь);
        Если НЕ ПустаяСтрока(Телефон) Тогда
            Если ПустаяСтрока(ВнешнийID) Тогда
                Возврат MAXОшибка(400, "external_id_required", "Требуется ID Django.");
            КонецЕсли;
            Попытка
                UUID = Новый УникальныйИдентификатор(ВнешнийID);
            Исключение
                Возврат MAXОшибка(400, "invalid_external_id", "Некорректный ID Django.");
            КонецПопытки;
        КонецЕсли;
    Исключение
        Возврат MAXОшибка(400, "invalid_request", "Некорректные данные MAX.");
    КонецПопытки;

    Попытка
        НачатьТранзакцию();
        MAXЗаблокироватьПользователей();
        ПоMAX = Справочники.ПользователиПриложения.НайтиПоРеквизиту("ИдентификаторMAX", MAXID);
        Если ПустаяСтрока(Телефон) Тогда
            Если ПоMAX.Пустая() Тогда
                ОтменитьТранзакцию();
                Возврат ОтветJSON(200, Новый Структура("status", "contact_required"));
            КонецЕсли;
            Профиль = MAXПрофиль(ПоMAX);
            ОтменитьТранзакцию();
            Если НЕ Профиль.isActive Тогда
                Возврат MAXОшибка(401, "user_inactive", "Пользователь неактивен.");
            КонецЕсли;
            Возврат ОтветJSON(200, Новый Структура("status,user", "ok", Профиль));
        КонецЕсли;

        ПоТелефону = MAXНайтиПользователяПоТелефону(Телефон);
        ПоВнешнемуID = Справочники.ПользователиПриложения.НайтиПоРеквизиту(
            "ИдентификаторВнешний", ВнешнийID);
        Конфликт = Ложь;
        Если НЕ ПоMAX.Пустая() Тогда
            Если ПоMAX.Телефон <> Телефон Тогда
                Конфликт = Истина;
            ИначеЕсли НЕ ПоТелефону.Пустая() И ПоMAX <> ПоТелефону Тогда
                Конфликт = Истина;
            КонецЕсли;
        КонецЕсли;
        Если НЕ ПоВнешнемуID.Пустая() Тогда
            Если ПоТелефону.Пустая() Тогда
                Конфликт = Истина;
            ИначеЕсли ПоВнешнемуID <> ПоТелефону Тогда
                Конфликт = Истина;
            КонецЕсли;
        КонецЕсли;
        Если Конфликт Тогда
            ОтменитьТранзакцию();
            Возврат MAXОшибка(409, "max_account_conflict",
                "Аккаунт MAX или телефон связан с другим пользователем.");
        КонецЕсли;
        Если ПоТелефону.Пустая() Тогда
            Объект = Справочники.ПользователиПриложения.СоздатьЭлемент();
            Объект.Телефон = Телефон;
            Объект.ИдентификаторВнешний = ВнешнийID;
            Объект.ИдентификаторMAX = MAXID;
            Объект.Имя = Имя;
            Объект.Фамилия = Фамилия;
            Объект.Активен = Истина;
            Объект.Записать();
            Ссылка = Объект.Ссылка;
            НаборРолей = РегистрыСведений.РолиПользователей.СоздатьНаборЗаписей();
            НаборРолей.Отбор.Пользователь.Установить(Ссылка);
            РольЗапись = НаборРолей.Добавить();
            РольЗапись.Пользователь = Ссылка;
            РольЗапись.Роль = Перечисления.РолиПользователей.Пользователь;
            НаборРолей.Записать(Истина);
        Иначе
            Ссылка = ПоТелефону;
            Объект = Ссылка.ПолучитьОбъект();
            Если Объект = Неопределено Или Объект.ПометкаУдаления
                Или НЕ Объект.Активен Тогда
                ОтменитьТранзакцию();
                Возврат MAXОшибка(401, "user_inactive", "Пользователь неактивен.");
            КонецЕсли;
            Если (НЕ ПустаяСтрока(Объект.ИдентификаторMAX)
                    И Объект.ИдентификаторMAX <> MAXID)
                Или Объект.ИдентификаторВнешний <> ВнешнийID Тогда
                ОтменитьТранзакцию();
                Возврат MAXОшибка(409, "max_account_conflict",
                    "Аккаунт MAX или телефон связан с другим пользователем.");
            КонецЕсли;
            Объект.ИдентификаторMAX = MAXID;
            Если ПустаяСтрока(Объект.Имя) Тогда Объект.Имя = Имя; КонецЕсли;
            Если ПустаяСтрока(Объект.Фамилия) Тогда Объект.Фамилия = Фамилия; КонецЕсли;
            Объект.Записать();
        КонецЕсли;
        Профиль = MAXПрофиль(Ссылка);
        ЗафиксироватьТранзакцию();
        Ответ = ОтветJSON(200, Новый Структура("status,user", "ok", Профиль));
        Возврат Ответ;
    Исключение
        ОтменитьТранзакцию();
        ЗаписьЖурналаРегистрации("ServiceCarAuth.MAXResolve",
            УровеньЖурналаРегистрации.Ошибка, , , "Не удалось разрешить MAX-аккаунт.");
        Возврат ОшибкаСервиса(500);
    КонецПопытки;
КонецФункции

// Ключ хранится в 1С; одноразовый код создаётся и доставляется шлюзом Django.
// Метки времени, лимиты попыток и использование кода проверяет 1С.
Функция MAXCodeIssuePost(Запрос)
    Если НЕ ВызванОтИмениТехническогоПользователя(Запрос) Тогда
        Возврат ОшибкаСервиса(403);
    КонецЕсли;
    Попытка
        Данные = MAXПрочитатьЗапрос(Запрос);
        Телефон = НормализоватьТелефонАвторизации(MAXПоле(Данные, "phone", 20));
        Код = MAXПоле(Данные, "code", 6);
        RequestID = MAXПоле(Данные, "requestId", 36);
