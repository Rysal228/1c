
Функция ОтветJSON(КодСостояния, Данные)
    Ответ = Новый HTTPСервисОтвет(КодСостояния);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Ответ.Заголовки.Вставить("Cache-Control", "no-store");
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8);
    Возврат Ответ;
КонецФункции

Функция ОшибкаСервиса(КодСостояния)
    Данные = Новый Структура("error", "authentication_service_unavailable");
    Возврат ОтветJSON(КодСостояния, Данные);
КонецФункции

Функция ОтказВПароле()
    Данные = Новый Структура("authenticated", Ложь);
    Возврат ОтветJSON(200, Данные);
КонецФункции

Функция ВызванОтИмениТехническогоПользователя(Запрос)
    Заголовок = Запрос.Заголовки.Получить("Authorization");
    Если ТипЗнч(Заголовок) <> Тип("Строка")
        Или Лев(Заголовок, 6) <> "Basic " Тогда
        Возврат Ложь;
    КонецЕсли;

    ТекущийПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если ТекущийПользовательИБ = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат ТекущийПользовательИБ.Имя = "servicecar-auth";
КонецФункции

Функция НормализоватьТелефонАвторизации(Телефон)
    Если ТипЗнч(Телефон) <> Тип("Строка") Тогда
        Возврат "";
    КонецЕсли;

    Телефон = СокрЛП(Телефон);
    Если Лев(Телефон, 1) = "+" Тогда
        Телефон = Сред(Телефон, 2);
    КонецЕсли;

    Если СтрДлина(Телефон) <> 11 Или Лев(Телефон, 1) <> "7" Тогда
        Возврат "";
    КонецЕсли;

    Для Позиция = 1 По 11 Цикл
        Если Найти("0123456789", Сред(Телефон, Позиция, 1)) = 0 Тогда
            Возврат "";
        КонецЕсли;
    КонецЦикла;

    Возврат Телефон;
КонецФункции

Функция ПолучитьРолиАвторизации(СсылкаПользователя)
    ЗапросДанных = Новый Запрос;
    ЗапросДанных.Текст =
        "ВЫБРАТЬ Роль ИЗ РегистрСведений.РолиПользователей "
        + "ГДЕ Пользователь = &Пользователь";
    ЗапросДанных.УстановитьПараметр("Пользователь", СсылкаПользователя);
    Выборка = ЗапросДанных.Выполнить().Выбрать();

    Роли = Новый Массив;
    Пока Выборка.Следующий() Цикл
        Код = "";
        Если Выборка.Роль = Перечисления.РолиПользователей.Пользователь Тогда
            Код = "user";
        ИначеЕсли Выборка.Роль = Перечисления.РолиПользователей.Специалист Тогда
            Код = "mechanic";
        ИначеЕсли Выборка.Роль = Перечисления.РолиПользователей.Менеджер Тогда
            Код = "admin";
        КонецЕсли;
        Если НЕ ПустаяСтрока(Код) И Роли.Найти(Код) = Неопределено Тогда
            Роли.Добавить(Код);
        КонецЕсли;
    КонецЦикла;
    Возврат Роли;
КонецФункции

Функция СовпадаетПарольПользователя(Ссылка, Пароль)
    Набор = РегистрыСведений.ПаролиПользователейПриложения.СоздатьНаборЗаписей();
    Набор.Отбор.Пользователь.Установить(Ссылка);
    Набор.Прочитать();
    Если Набор.Количество() <> 1 Тогда
        Возврат Ложь;
    КонецЕсли;

    Для Каждого Запись Из Набор Цикл
        Значение = Запись.СохраняемоеЗначение;
        Если ПустаяСтрока(Значение) Тогда
            Возврат Ложь;
        КонецЕсли;
        Возврат ПроверитьСоответствиеПароляПользователяСохраняемомуЗначению(
            Пароль, Значение);
    КонецЦикла;
    Возврат Ложь;
КонецФункции

Функция PasswordVerifyPost(Запрос)
    Если НЕ ВызванОтИмениТехническогоПользователя(Запрос) Тогда
        Возврат ОшибкаСервиса(403);
    КонецЕсли;

    Попытка
        Тело = Запрос.ПолучитьТелоКакСтроку();
        Если СтрДлина(Тело) > 4096 Тогда
            Возврат ОшибкаСервиса(413);
        КонецЕсли;

        Чтение = Новый ЧтениеJSON;
        Чтение.УстановитьСтроку(Тело);
        Данные = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();

        Если ТипЗнч(Данные) <> Тип("Структура") Тогда
            Возврат ОшибкаСервиса(400);
        КонецЕсли;

        Телефон = Неопределено;
        Пароль = Неопределено;
        Если НЕ Данные.Свойство("phone", Телефон)
            Или НЕ Данные.Свойство("password", Пароль) Тогда
            Возврат ОшибкаСервиса(400);
        КонецЕсли;

        Телефон = НормализоватьТелефонАвторизации(Телефон);
        Если ПустаяСтрока(Телефон)
            Или ТипЗнч(Пароль) <> Тип("Строка")
            Или СтрДлина(Пароль) < 1
            Или СтрДлина(Пароль) > 128 Тогда
            Возврат ОтказВПароле();
        КонецЕсли;

        Ссылка = Справочники.ПользователиПриложения.НайтиПоРеквизиту(
            "Телефон", Телефон);
        Если Ссылка.Пустая() Тогда
            Возврат ОтказВПароле();
        КонецЕсли;

        Пользователь = Ссылка.ПолучитьОбъект();
        Если Пользователь = Неопределено Тогда
            Возврат ОтказВПароле();
        КонецЕсли;
        Если Пользователь.ПометкаУдаления Или НЕ Пользователь.Активен Тогда
            Возврат ОтказВПароле();
        КонецЕсли;

        Если НЕ СовпадаетПарольПользователя(Ссылка, Пароль) Тогда
            Возврат ОтказВПароле();
        КонецЕсли;

        Роли = ПолучитьРолиАвторизации(Ссылка);
        Если Роли.Количество() = 0 Тогда
            Возврат ОтказВПароле();
        КонецЕсли;

        Ответ = Новый Структура;
        Ответ.Вставить("authenticated", Истина);
        Ответ.Вставить("onecId", Строка(Ссылка.УникальныйИдентификатор()));
        Ответ.Вставить("phone", Пользователь.Телефон);
        Ответ.Вставить("isActive", Истина);
        Ответ.Вставить("roles", Роли);
        Возврат ОтветJSON(200, Ответ);
    Исключение
        Возврат ОшибкаСервиса(500);
    КонецПопытки;
КонецФункции