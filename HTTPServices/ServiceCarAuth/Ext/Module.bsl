            Возврат MAXОшибка(401, "max_not_available", "Вход через MAX недоступен.");
        КонецЕсли;
        Предыдущий = MAXСостояниеКода(Ссылка);
        Сейчас = ТекущаяДата();
        Если Предыдущий <> Неопределено
            И Сейчас < MAXДатаИзСтроки(Предыдущий.createdAt) + 60 Тогда
            ОтменитьТранзакцию();
            Возврат MAXОшибка(429, "max_code_throttled",
                "Повторно запросить код можно через 60 секунд.");
