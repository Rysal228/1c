Перем ЗаказНужноОбновитьБронь;

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
    Если ОбменДанными.Загрузка Тогда
        Возврат;
    КонецЕсли;

    // Единый порядок блокировок: расписание, затем документ. Нужен и при
    // сохранении непосредственно из формы 1С, минуя HTTP-сервис.
    ЗаказДокЗаблокироватьКалендарь();
	
	СтараяВерсия = Неопределено;
	
    Если Клиент.Пустая() Или Автомобиль.Пустая() Тогда
        ВызватьИсключение "Необходимо выбрать клиента и автомобиль.";
    КонецЕсли;
    Если СтатусЗаказа.Пустая() Или СтатусРабот.Пустая()
        Или СтатусОплаты.Пустая() Тогда
        ВызватьИсключение "Необходимо заполнить все три статуса заказа.";
    КонецЕсли;
    Если СтатусЗаказа.ПометкаУдаления Или СтатусРабот.ПометкаУдаления
        Или СтатусОплаты.ПометкаУдаления Тогда
        ВызватьИсключение "Нельзя выбрать статус, помеченный на удаление.";
    КонецЕсли;

    КлиентОбъект = Клиент.ПолучитьОбъект();
    АвтоОбъект = Автомобиль.ПолучитьОбъект();
    Если КлиентОбъект = Неопределено Или АвтоОбъект = Неопределено
        Или КлиентОбъект.ПометкаУдаления Или АвтоОбъект.ПометкаУдаления Тогда
        ВызватьИсключение "Клиент или автомобиль не найден.";
    КонецЕсли;
    Если АвтоОбъект.ВладелецАвтомобиля <> Клиент Тогда
        ВызватьИсключение "Автомобиль принадлежит другому клиенту.";
    КонецЕсли;
    Если ЭтоНовый() Тогда
        Если НЕ КлиентОбъект.Активен Тогда
            ВызватьИсключение "Неактивный клиент не может создать заказ.";
        КонецЕсли;
        Если АвтоОбъект.ВАрхиве Тогда
            ВызватьИсключение "Архивный автомобиль недоступен для нового заказа.";
        КонецЕсли;
        Если НЕ ЗначениеЗаполнено(ДатаЗаписи) Тогда
            ВызватьИсключение "Укажите дату и время записи.";
        КонецЕсли;
        ТелефонКлиентаСнимок = Лев(КлиентОбъект.Телефон, 20);
        ФиоКлиентаСнимок = Лев(СокрЛП(КлиентОбъект.Фамилия + " "
            + КлиентОбъект.Имя + " " + КлиентОбъект.Отчество), 150);
        МаркаАвтомобиля = АвтоОбъект.Марка;
        МодельАвтомобиля = АвтоОбъект.Модель;
        МаркаСнимок = АвтоОбъект.Марка.Наименование;
        МодельСнимок = АвтоОбъект.Модель.Наименование;
        ГодВыпускаСнимок = АвтоОбъект.ГодВыпуска;
        VINСнимок = АвтоОбъект.VIN;
        ГосНомерСнимок = АвтоОбъект.ГосНомер;
    Иначе
        // Нельзя привязать исторический заказ к другому автомобилю/клиенту.
        СтараяВерсия = Ссылка.ПолучитьОбъект();
        Если СтараяВерсия <> Неопределено Тогда
            Если СтараяВерсия.Клиент <> Клиент
                Или СтараяВерсия.Автомобиль <> Автомобиль Тогда
                ВызватьИсключение "Клиента и автомобиль существующего заказа нельзя изменять.";
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;

    КодСтатуса = СтатусЗаказа.КодСтатуса;
    СтарыйКодСтатуса = "";
    Если СтараяВерсия <> Неопределено Тогда
        СтарыйКодСтатуса = СтараяВерсия.СтатусЗаказа.КодСтатуса;
    КонецЕсли;

    // Терминальные заказы не редактируются обычным сохранением документа.
    Если СтарыйКодСтатуса = "closed" Или СтарыйКодСтатуса = "cancelled" Тогда
        ВызватьИсключение "Закрытый или отменённый заказ нельзя изменять.";
    КонецЕсли;

    Если КодСтатуса = "closed" Тогда
        // Закрытие возможно только в 1С. Статус присваивается вручную
        // после выдачи автомобиля и подтверждения оплаты.
        Если СтарыйКодСтатуса <> "completed" Тогда
            ВызватьИсключение "Закрывать можно только завершённый заказ.";
        КонецЕсли;
        Если СтатусРабот.КодСтатуса <> "vehicle_handed_over" Тогда
            ВызватьИсключение "Перед закрытием подтвердите выдачу автомобиля владельцу.";
        КонецЕсли;
        Если СтатусОплаты.КодСтатуса <> "paid" Тогда
            ВызватьИсключение "Перед закрытием необходимо подтвердить оплату.";
        КонецЕсли;
        Если НЕ ПустаяСтрока(СокрЛП(ПричинаОтказа)) Тогда
            ВызватьИсключение "Отказанный заказ нельзя закрыть как выполненный.";
        КонецЕсли;
        ДатаЗакрытия = ТекущаяДата();
    ИначеЕсли КодСтатуса = "cancelled" Тогда
        Если СтарыйКодСтатуса <> "under_review"
            И СтарыйКодСтатуса <> "in_progress" Тогда
            ВызватьИсключение "Отменить можно только заказ на рассмотрении или в работе.";
        КонецЕсли;
        Если ПустаяСтрока(СокрЛП(ПричинаОтказа)) Тогда
            ВызватьИсключение "Укажите причину отмены заказа.";
        КонецЕсли;
        // Отказ — не выполненная работа. Статус работ ставим одновременно.
        СтатусОтказа = Справочники.СтатусыРабот.НайтиПоРеквизиту(
            "КодСтатуса", "refused");
        Если СтатусОтказа.Пустая() Или СтатусОтказа.ПометкаУдаления Тогда
            ВызватьИсключение "Не найден статус работ «Отказано» (refused).";
        КонецЕсли;
        СтатусРабот = СтатусОтказа;
    ИначеЕсли КодСтатуса = "completed" Тогда
        Если СтарыйКодСтатуса <> "in_progress"
            И СтарыйКодСтатуса <> "completed" Тогда
            ВызватьИсключение "Завершить можно только заказ в работе.";
        КонецЕсли;
        Если НЕ ПустаяСтрока(СокрЛП(ПричинаОтказа)) Тогда
            ВызватьИсключение "Заказ с причиной отказа необходимо отменить.";
        КонецЕсли;
    КонецЕсли;
    Если КодСтатуса <> "closed" И КодСтатуса <> "completed"
        И СтатусРабот.КодСтатуса = "vehicle_handed_over" Тогда
        ВызватьИсключение "Выдачу автомобиля можно отмечать только у завершённого заказа.";
    КонецЕсли;

    // При фактическом завершении работ пост освобождается только тогда,
    // когда автомобиль перемещён на отдельную стоянку. При отсутствии мест
    // машина продолжает занимать пост до закрытия заказа.
    Если КодСтатуса = "completed" И СтарыйКодСтатуса <> "completed" Тогда
        ДатаЗавершенияРабот = ТекущаяДата();
        ЗонаРазмещения = ПланированиеЗаписей.РазмещениеПослеРабот(Ссылка);
    ИначеЕсли КодСтатуса = "closed" Или КодСтатуса = "cancelled" Тогда
        ЗонаРазмещения = "";
    ИначеЕсли КодСтатуса <> "completed" Тогда
        // Учёт раннего фактического приезда на стоянку в этом этапе не включён.
        ЗонаРазмещения = "service";
    ИначеЕсли ПустаяСтрока(ЗонаРазмещения) Тогда
        ЗонаРазмещения = "service";
    КонецЕсли;
    Если КодСтатуса = "completed" И ЗонаРазмещения <> "service"
        И ЗонаРазмещения <> "parking" Тогда
        ВызватьИсключение "Укажите зону service или parking.";
    КонецЕсли;
    Если КодСтатуса = "completed" И ЗонаРазмещения = "parking" Тогда
        НастройкиПлощадок = ПланированиеЗаписей.Настройки();
        Если НЕ НастройкиПлощадок.ЕстьСтоянка Тогда
            ВызватьИсключение "Стоянка выключена в НастройкиЗаписи.";
        КонецЕсли;
        Если СтарыйКодСтатуса <> "completed"
            Или СтараяВерсия.ЗонаРазмещения <> ЗонаРазмещения Тогда
            Если ПланированиеЗаписей.МестНаСтоянкеЗанято(Ссылка)
                >= НастройкиПлощадок.Стоянка Тогда
                ВызватьИсключение "На стоянке нет свободных мест.";
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;

    ВидыРаботВЗаказе = Новый Массив;
    ИДСтрок = Новый Массив;
    Для Каждого СтрокаРаботы Из Работы Цикл
        Если СтрокаРаботы.ВидРабот.Пустая()
            Или СтрокаРаботы.ВидРабот.ПометкаУдаления Тогда
            ВызватьИсключение "В каждой добавленной строке выберите вид из справочника ВидыРабот.";
        КонецЕсли;
        Если ВидыРаботВЗаказе.Найти(СтрокаРаботы.ВидРабот) <> Неопределено Тогда
            ВызватьИсключение "Один вид работы нельзя добавлять дважды.";
        КонецЕсли;
        ВидыРаботВЗаказе.Добавить(СтрокаРаботы.ВидРабот);
        Если СтрокаРаботы.Цена < 0 Тогда
            ВызватьИсключение "Стоимость работы не может быть отрицательной.";
        КонецЕсли;
        Если ПустаяСтрока(СтрокаРаботы.ИдентификаторСтроки) Тогда
            СтрокаРаботы.ИдентификаторСтроки =
                Строка(Новый УникальныйИдентификатор);
        Иначе
            Попытка
                СтрокаРаботы.ИдентификаторСтроки = Строка(
                    Новый УникальныйИдентификатор(СтрокаРаботы.ИдентификаторСтроки));
            Исключение
                ВызватьИсключение "Некорректный идентификатор строки работы.";
            КонецПопытки;
        КонецЕсли;
        Если ИДСтрок.Найти(СтрокаРаботы.ИдентификаторСтроки) <> Неопределено Тогда
            ВызватьИсключение "Повторяется идентификатор строки работы.";
        КонецЕсли;
        ИДСтрок.Добавить(СтрокаРаботы.ИдентификаторСтроки);
    КонецЦикла;
    Если НЕ ЗначениеЗаполнено(ДатаЗаписи) Тогда
        ВызватьИсключение "Укажите дату и время записи.";
    КонецЕсли;

    Если КодСтатуса <> "closed" И КодСтатуса <> "cancelled" Тогда
        // При изменении норм в каталоге уже созданные брони не меняются
        // самопроизвольно — только при изменении состава работ или даты.
        ПересчитатьПлан = ЭтоНовый() Или Ссылка.ДатаЗаписи <> ДатаЗаписи;
        Если НЕ ЭтоНовый() И НЕ ПересчитатьПлан Тогда
            Если СтараяВерсия.Работы.Количество() <> Работы.Количество() Тогда
                ПересчитатьПлан = Истина;
            Иначе
                Для Каждого Работа Из Работы Цикл
                    Если СтараяВерсия.Работы.Найти(Работа.ВидРабот, "ВидРабот") = Неопределено Тогда
                        ПересчитатьПлан = Истина;
                        Прервать;
                    КонецЕсли;
                КонецЦикла;
            КонецЕсли;
        КонецЕсли;
        Если ПересчитатьПлан Тогда
            ВидыДляПлана = Новый Массив;
            Для Каждого СтрокаРаботы Из Работы Цикл
                ВидыДляПлана.Добавить(СтрокаРаботы.ВидРабот);
            КонецЦикла;
            НастройкиПлана = ПланированиеЗаписей.Настройки();
            ПлановаяДатаОкончания = ПланированиеЗаписей.ОкончаниеПоГрафику(
                ДатаЗаписи, ПланированиеЗаписей.МинутыРабот(ВидыДляПлана, НастройкиПлана));
        ИначеЕсли НЕ ЗначениеЗаполнено(ПлановаяДатаОкончания) Тогда
            // Мягкая миграция старых заказов без снимка норматива.
            // Их сохранение/закрытие не зависит от ещё не заполненных норм каталога.
            СтарыеНастройки = ПланированиеЗаписей.Настройки();
            ПлановаяДатаОкончания = ДатаЗаписи + СтарыеНастройки.Приемка * 60;
        КонецЕсли;
    Иначе
        ПересчитатьПлан = Ложь;
    КонецЕсли;
    ЗаказНужноОбновитьБронь = ЭтоНовый();
    Если НЕ ЭтоНовый() Тогда
        ЗаказНужноОбновитьБронь = Ссылка.ДатаЗаписи <> ДатаЗаписи
            Или Ссылка.ПометкаУдаления <> ПометкаУдаления
            Или ПересчитатьПлан Или СтарыйКодСтатуса <> КодСтатуса
            Или СтараяВерсия.ЗонаРазмещения <> ЗонаРазмещения;
    КонецЕсли;
    Если ЗаказНужноОбновитьБронь Тогда
        ЗаказДокЗаблокироватьКалендарь();
        Если НЕ ПометкаУдаления И КодСтатуса <> "closed"
            И КодСтатуса <> "cancelled" И ДатаЗаписи > ТекущаяДата()
            И (ЭтоНовый() Или ПересчитатьПлан) Тогда
            ЗаказДокПроверитьСлот(ДатаЗаписи, Ссылка);
        КонецЕсли;
    КонецЕсли;
    Назначенные = Новый Массив;
    Для Каждого СтрокаСпециалиста Из Специалисты Цикл
        Если СтрокаСпециалиста.Специалист.Пустая() Тогда
            ВызватьИсключение "Пустая строка списка специалистов.";
        КонецЕсли;
        Если Назначенные.Найти(СтрокаСпециалиста.Специалист) <> Неопределено Тогда
            ВызватьИсключение "Один специалист не может быть назначен дважды.";
        КонецЕсли;
        Назначенные.Добавить(СтрокаСпециалиста.Специалист);
        Профиль = СтрокаСпециалиста.Специалист.ПолучитьОбъект();
        Если Профиль = Неопределено Или Профиль.ПометкаУдаления
            Или НЕ Профиль.Активен Тогда
            ВызватьИсключение "Выбранный специалист неактивен.";
        КонецЕсли;
        Проверка = Новый Запрос;
        Проверка.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Роль "
            + "ИЗ РегистрСведений.РолиПользователей "
            + "ГДЕ Пользователь = &Пользователь И Роль = &Роль";
        Проверка.УстановитьПараметр("Пользователь", СтрокаСпециалиста.Специалист);
        Проверка.УстановитьПараметр("Роль", Перечисления.РолиПользователей.Специалист);
        Если Проверка.Выполнить().Пустой() Тогда
            ВызватьИсключение "Пользователь не имеет роли специалиста.";
        КонецЕсли;
	КонецЦикла;
	ЗаказДокОбновитьИсториюСпециалистов(СтараяВерсия);
КонецПроцедуры

// Факт назначения фиксируется один раз для каждой пары заказ-специалист.
// Сохраняется и после удаления исполнителя из текущего списка.
// Запись выполняется при любом сохранении документа, в том числе из формы 1С.
Процедура ЗаказДокОбновитьИсториюСпециалистов(СтараяВерсия)
    СтараяЗавершена = Ложь;
    Если СтараяВерсия <> Неопределено Тогда
        СтараяЗавершена = НЕ СтараяВерсия.СтатусЗаказа.Пустая()
            И (СтараяВерсия.СтатусЗаказа.КодСтатуса = "closed"
                Или (СтараяВерсия.СтатусЗаказа.КодСтатуса = "completed"
                    И ПустаяСтрока(СокрЛП(СтараяВерсия.ПричинаОтказа))));
        // Только первое заполнение ранее неотслеживаемого заказа
        // допускает восстановление участия по старому списку специалистов.
        ПервоеЗаполнениеИстории = ИсторияНазначенийСпециалистов.Количество() = 0;
        // Заполнить историю прежних назначений в существующих документах.
        Для Каждого СтрокаСтарого Из СтараяВерсия.Специалисты Цикл
            СтрокаИстории = ИсторияНазначенийСпециалистов.Найти(
                СтрокаСтарого.Специалист, "Специалист");
            Если СтрокаИстории = Неопределено Тогда
                СтрокаИстории = ИсторияНазначенийСпециалистов.Добавить();
                СтрокаИстории.Специалист = СтрокаСтарого.Специалист;
                СтрокаИстории.ДатаПервогоНазначения = СтараяВерсия.Дата;
            КонецЕсли;
            Если СтараяЗавершена И ПервоеЗаполнениеИстории Тогда
                СтрокаИстории.УчаствовалПриЗавершении = Истина;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

    // Завершение фиксируем только в момент смены статуса (или при
    // создании уже завершённого документа), не задним числом при новом назначении.
    ЗаканчиваетсяСейчас = СтатусЗаказа.КодСтатуса = "completed"
        И ПустаяСтрока(СокрЛП(ПричинаОтказа))
        И НЕ СтараяЗавершена;
    Для Каждого СтрокаТекущего Из Специалисты Цикл
        СтрокаИстории = ИсторияНазначенийСпециалистов.Найти(
            СтрокаТекущего.Специалист, "Специалист");
        Если СтрокаИстории = Неопределено Тогда
            СтрокаИстории = ИсторияНазначенийСпециалистов.Добавить();
            СтрокаИстории.Специалист = СтрокаТекущего.Специалист;
            СтрокаИстории.ДатаПервогоНазначения = ТекущаяДата();
        КонецЕсли;
        Если ЗаканчиваетсяСейчас Тогда
            СтрокаИстории.УчаствовалПриЗавершении = Истина;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
    Если ОбменДанными.Загрузка Или НЕ ЗаказНужноОбновитьБронь Тогда
        Возврат;
    КонецЕсли;
    ЗаказДокСнятьБронь(Ссылка);
    Если НЕ ПометкаУдаления И СтатусЗаказа.КодСтатуса <> "closed"
        И СтатусЗаказа.КодСтатуса <> "cancelled" Тогда
        ЗаказДокЗаписатьБронь(Ссылка, ДатаЗаписи);
    КонецЕсли;
КонецПроцедуры

// При физическом удалении документа его интервалы больше не заняты.
Процедура ПриУдалении(Отказ)
    Если ОбменДанными.Загрузка Тогда
        Возврат;
    КонецЕсли;
    ЗаказДокЗаблокироватьКалендарь();
    ЗаказДокСнятьБронь(Ссылка);
КонецПроцедуры

Процедура ЗаказДокЗаблокироватьКалендарь()
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрСведений.ЗанятыеИнтервалы");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура ЗаказДокПроверитьСлот(ДатаПосещения, ТекущийЗаказ)
    ВидыДляПроверки = Новый Массив;
    Для Каждого Работа Из Работы Цикл
        ВидыДляПроверки.Добавить(Работа.ВидРабот);
    КонецЦикла;
    ПланированиеЗаписей.ПроверитьЗапись(ДатаПосещения, ВидыДляПроверки, ТекущийЗаказ);
КонецПроцедуры

Процедура ЗаказДокСнятьБронь(Заказ)
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Дата, НачалоМинут, ИдентификаторИнтервала "
        + "ИЗ РегистрСведений.ЗанятыеИнтервалы ГДЕ Заказ = &Заказ";
    Запрос.УстановитьПараметр("Заказ", Заказ);
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Набор = РегистрыСведений.ЗанятыеИнтервалы.СоздатьНаборЗаписей();
        Набор.Отбор.Дата.Установить(Выборка.Дата);
        Набор.Отбор.НачалоМинут.Установить(Выборка.НачалоМинут);
        Набор.Отбор.ИдентификаторИнтервала.Установить(
            Выборка.ИдентификаторИнтервала);
        Набор.Прочитать();
        Набор.Очистить();
        Набор.Записать();
    КонецЦикла;
КонецПроцедуры

Процедура ЗаказДокЗаписатьБронь(Заказ, ДатаПосещения)
    КонецБрони = ПлановаяДатаОкончания;
    Если НЕ ЗначениеЗаполнено(КонецБрони) Тогда
        НастройкиПриемки = ПланированиеЗаписей.Настройки();
        КонецБрони = ДатаПосещения + НастройкиПриемки.Приемка * 60;
    КонецЕсли;
    Если СтатусЗаказа.КодСтатуса = "completed" И ЗонаРазмещения = "parking"
        И ЗначениеЗаполнено(ДатаЗавершенияРабот)
        И ДатаЗавершенияРабот < КонецБрони Тогда
        КонецБрони = ДатаЗавершенияРабот;
    КонецЕсли;
    День = НачалоДня(ДатаПосещения);
    Пока День < КонецБрони Цикл
        От = ?(ДатаПосещения > День, (ДатаПосещения - День) / 60, 0);
        До = ?(КонецБрони < День + 86400, (КонецБрони - День) / 60, 1440);
        Если До > От Тогда
            Набор = РегистрыСведений.ЗанятыеИнтервалы.СоздатьНаборЗаписей();
            СтрокаБрони = Набор.Добавить();
            СтрокаБрони.Дата = День;
            СтрокаБрони.НачалоМинут = От;
            СтрокаБрони.КонецМинут = До;
            СтрокаБрони.ИдентификаторИнтервала = Строка(Новый УникальныйИдентификатор);
            СтрокаБрони.Заказ = Заказ;
            Набор.Записать(Ложь);
        КонецЕсли;
        День = День + 86400;
    КонецЦикла;
КонецПроцедуры
