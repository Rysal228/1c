// Общий алгоритм календаря. Все операции записи выполняют проверку под
// исключительной блокировкой регистра ЗанятыеИнтервалы в одной транзакции.

Функция Настройки() Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 ДлительностьМинут, ИнтервалМинут, "
        + "КоличествоПостов, СтоянкаВключена, КоличествоМестСтоянки "
        + "ИЗ РегистрСведений.НастройкиЗаписи ГДЕ Ключ = &Ключ";
    Запрос.УстановитьПараметр("Ключ", "main");
    Выборка = Запрос.Выполнить().Выбрать();
    Если НЕ Выборка.Следующий() Тогда
        ВызватьИсключение "Заполните регистр НастройкиЗаписи с ключом main.";
    КонецЕсли;
    Если Выборка.ДлительностьМинут < 5 Или Выборка.ДлительностьМинут > 1440
        Или Выборка.ИнтервалМинут < 5 Или Выборка.ИнтервалМинут > Выборка.ДлительностьМинут
        Или Выборка.КоличествоПостов < 1 Или Выборка.КоличествоПостов > 999
        Или (Выборка.СтоянкаВключена И (Выборка.КоличествоМестСтоянки < 1
            Или Выборка.КоличествоМестСтоянки > 999)) Тогда
        ВызватьИсключение "Проверьте время приёмки, шаг записи и вместимость в НастройкиЗаписи (main).";
    КонецЕсли;
    Возврат Новый Структура("Приемка,Шаг,Посты,ЕстьСтоянка,Стоянка",
        Выборка.ДлительностьМинут, Выборка.ИнтервалМинут,
        Выборка.КоличествоПостов, Выборка.СтоянкаВключена,
        ?(Выборка.СтоянкаВключена, Выборка.КоличествоМестСтоянки, 0));
КонецФункции

Функция ГрафикДня(День) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Рабочий, НачалоМинут, КонецМинут "
        + "ИЗ РегистрСведений.НедельныйГрафик ГДЕ ДеньНедели = &День";
    Запрос.УстановитьПараметр("День", ДеньНедели(День) - 1);
    Выборка = Запрос.Выполнить().Выбрать();
    Если НЕ Выборка.Следующий() Тогда
        Возврат Новый Структура("Рабочий,Начало,Конец", Ложь, 0, 0);
    КонецЕсли;
    Если Выборка.Рабочий И (Выборка.НачалоМинут < 0
        Или Выборка.КонецМинут > 1440
        Или Выборка.НачалоМинут >= Выборка.КонецМинут) Тогда
        ВызватьИсключение "Некорректный недельный график.";
    КонецЕсли;
    Возврат Новый Структура("Рабочий,Начало,Конец", Выборка.Рабочий,
        Выборка.НачалоМинут, Выборка.КонецМинут);
КонецФункции

Функция МинутыРабот(ВидыРабот, НастройкиЗаписи) Экспорт
    Минуты = НастройкиЗаписи.Приемка;
    Уникальные = Новый Массив;
    Для Каждого Вид Из ВидыРабот Цикл
        Если Вид.Пустая() Или Вид.ПометкаУдаления Тогда
            ВызватьИсключение "Выберите действующий вид работы.";
        КонецЕсли;
        Если Уникальные.Найти(Вид) <> Неопределено Тогда
            ВызватьИсключение "Повторяющийся вид работы.";
        КонецЕсли;
        Уникальные.Добавить(Вид);
        Норма = Вид.ПлановаяДлительностьМинут;
        Если Норма < 1 Тогда
            ВызватьИсключение "Укажите плановую длительность в справочнике ВидыРабот: "
                + Вид.Наименование;
        КонецЕсли;
        Минуты = Минуты + Норма;
    КонецЦикла;
    Возврат Минуты;
КонецФункции

Функция ОкончаниеПоГрафику(Начало, Минуты) Экспорт
    Осталось = Минуты;
    Момент = Начало;
    // Защита от полностью нерабочего календаря и ошибочных норм времени.
    Для НомерДня = 0 По 90 Цикл
        День = НачалоДня(Момент);
        График = ГрафикДня(День);
        Если График.Рабочий Тогда
            НачалоРаботы = День + График.Начало * 60;
            КонецРаботы = День + График.Конец * 60;
            Если Момент < НачалоРаботы Тогда
                Момент = НачалоРаботы;
            КонецЕсли;
            Если Момент < КонецРаботы Тогда
                Доступно = (КонецРаботы - Момент) / 60;
                Если Осталось <= Доступно Тогда
                    Возврат Момент + Осталось * 60;
                КонецЕсли;
                Осталось = Осталось - Доступно;
            КонецЕсли;
        КонецЕсли;
        Момент = День + 86400;
    КонецЦикла;
    ВызватьИсключение "Не удаётся рассчитать окончание работ: нет рабочего времени в ближайшие 90 дней.";
КонецФункции

// Отображаемые будущие брони и фактически находящиеся в сервисе машины
// считаются раздельно. Текущую просроченную работу нельзя освобождать
// автоматически, пока менеджер не подтвердил её завершение.
Функция ИнтервалыПостов(ДоМомента, ИсключитьЗаказ, НастройкиЗаписи) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Ссылка, ДатаЗаписи, ПлановаяДатаОкончания, "
        + "ДатаЗавершенияРабот, ЗонаРазмещения, СтатусЗаказа.КодСтатуса КАК Код "
        + "ИЗ Документ.ЗаказыНаОбслуживание "
        + "ГДЕ НЕ ПометкаУдаления И ДатаЗаписи < &Конец "
        + "И СтатусЗаказа.КодСтатуса <> &Закрыт "
        + "И СтатусЗаказа.КодСтатуса <> &Отменен "
        + "И Ссылка <> &ТекущийЗаказ";
    Запрос.УстановитьПараметр("Конец", ДоМомента);
    Запрос.УстановитьПараметр("Закрыт", "closed");
    Запрос.УстановитьПараметр("Отменен", "cancelled");
    Запрос.УстановитьПараметр("ТекущийЗаказ", ИсключитьЗаказ);
    Выборка = Запрос.Выполнить().Выбрать();
    Результат = Новый Массив;
    Пока Выборка.Следующий() Цикл
        Конец = Выборка.ПлановаяДатаОкончания;
        Если НЕ ЗначениеЗаполнено(Конец) Тогда
            // Старые документы без снимка плана занимают минимум приёмку.
            Конец = Выборка.ДатаЗаписи + НастройкиЗаписи.Приемка * 60;
        КонецЕсли;
        Если Выборка.Код = "completed" Тогда
            Если НастройкиЗаписи.ЕстьСтоянка И Выборка.ЗонаРазмещения = "parking" Тогда
                Конец = Выборка.ДатаЗавершенияРабот;
                Если НЕ ЗначениеЗаполнено(Конец) Тогда
                    Конец = ТекущаяДата();
                КонецЕсли;
            Иначе
                // Машина ожидает выдачи на посту, прогноз окончания не освобождает место.
                Конец = ДоМомента;
            КонецЕсли;
        ИначеЕсли Выборка.Код = "in_progress" И Конец < ТекущаяДата() Тогда
            // Просроченные незавершённые работы занимают пост до явной смены статуса.
            Конец = ДоМомента;
        КонецЕсли;
        Если Конец > Выборка.ДатаЗаписи Тогда
            Результат.Добавить(Новый Структура("Начало,Конец",
                Выборка.ДатаЗаписи, Конец));
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции

Процедура ПроверитьВместимость(Начало, Конец, ИсключитьЗаказ, НастройкиЗаписи) Экспорт
    События = Новый ТаблицаЗначений;
    События.Колонки.Добавить("Момент");
    События.Колонки.Добавить("Изменение");
    Интервалы = ИнтервалыПостов(Конец, ИсключитьЗаказ, НастройкиЗаписи);
    Интервалы.Добавить(Новый Структура("Начало,Конец", Начало, Конец));
    Для Каждого Интервал Из Интервалы Цикл
        Если Интервал.Начало >= Конец Или Интервал.Конец <= Начало Тогда
            Продолжить;
        КонецЕсли;
        Событие = События.Добавить();
        Событие.Момент = ?(Интервал.Начало < Начало, Начало, Интервал.Начало);
        Событие.Изменение = 1;
        Событие = События.Добавить();
        Событие.Момент = ?(Интервал.Конец > Конец, Конец, Интервал.Конец);
        Событие.Изменение = -1;
    КонецЦикла;
    // При совпадении концов интервалов сначала освобождаем место.
    События.Сортировать("Момент ВОЗР, Изменение ВОЗР");
    НаПостах = 0;
    Для Каждого Событие Из События Цикл
        НаПостах = НаПостах + Событие.Изменение;
        Если НаПостах > НастройкиЗаписи.Посты Тогда
            ВызватьИсключение "Нет свободных постов обслуживания на выбранный период.";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ПроверитьЗапись(Начало, ВидыРабот, ИсключитьЗаказ) Экспорт
    Параметры = Настройки();
    Если Начало <= ТекущаяДата() Или Секунда(Начало) <> 0 Тогда
        ВызватьИсключение "Дата записи должна быть в будущем, без секунд.";
    КонецЕсли;
    День = НачалоДня(Начало);
    МинутыОтНачала = Час(Начало) * 60 + Минута(Начало);
    График = ГрафикДня(День);
    Если НЕ График.Рабочий Или МинутыОтНачала < График.Начало
        Или МинутыОтНачала + Параметры.Приемка > График.Конец
        Или (МинутыОтНачала - График.Начало) % Параметры.Шаг <> 0 Тогда
        ВызватьИсключение "Время записи не входит в рабочий график.";
    КонецЕсли;
    ЗапросБлоков = Новый Запрос;
    ЗапросБлоков.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Дата "
        + "ИЗ РегистрСведений.БлокировкиЗаписи "
        + "ГДЕ Дата = &День И НачалоМинут < &Конец "
        + "И КонецМинут > &Начало";
    ЗапросБлоков.УстановитьПараметр("День", День);
    ЗапросБлоков.УстановитьПараметр("Начало", МинутыОтНачала);
    ЗапросБлоков.УстановитьПараметр("Конец", МинутыОтНачала + Параметры.Приемка);
    Если НЕ ЗапросБлоков.Выполнить().Пустой() Тогда
        ВызватьИсключение "Время перекрыто блокировкой графика.";
    КонецЕсли;
    ПлановыйКонец = ОкончаниеПоГрафику(Начало,
        МинутыРабот(ВидыРабот, Параметры));
    ПроверитьВместимость(Начало, ПлановыйКонец, ИсключитьЗаказ, Параметры);
КонецПроцедуры

Функция МестНаСтоянкеЗанято(ИсключитьЗаказ) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Ссылка) КАК Всего "
        + "ИЗ Документ.ЗаказыНаОбслуживание "
        + "ГДЕ НЕ ПометкаУдаления И СтатусЗаказа.КодСтатуса = &Завершен "
        + "И ЗонаРазмещения = &Стоянка И Ссылка <> &Заказ";
    Запрос.УстановитьПараметр("Завершен", "completed");
    Запрос.УстановитьПараметр("Стоянка", "parking");
    Запрос.УстановитьПараметр("Заказ", ИсключитьЗаказ);
    Выборка = Запрос.Выполнить().Выбрать();
    Выборка.Следующий();
    Возврат Выборка.Всего;
КонецФункции

Функция РазмещениеПослеРабот(ИсключитьЗаказ) Экспорт
    Параметры = Настройки();
    Если Параметры.ЕстьСтоянка
        И МестНаСтоянкеЗанято(ИсключитьЗаказ) < Параметры.Стоянка Тогда
        Возврат "parking";
    КонецЕсли;
    Возврат "service";
КонецФункции
