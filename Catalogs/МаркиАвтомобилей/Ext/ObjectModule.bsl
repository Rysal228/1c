Процедура ПередЗаписью(Отказ)
    Наименование = СокрЛП(Наименование);
    Если ПустаяСтрока(Наименование) Тогда
        ВызватьИсключение "Укажите наименование марки автомобиля.";
    КонецЕсли;

    // Исключаем дубликаты с разным регистром и пробелами по краям. 
    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ
        |   Марки.Ссылка КАК Ссылка,
        |   Марки.Наименование КАК Наименование
        |ИЗ
        |   Справочник.МаркиАвтомобилей КАК Марки";

    Выборка = Запрос.Выполнить().Выбрать();
    ИскомоеИмя = ВРег(Наименование);
    Пока Выборка.Следующий() Цикл
        Если Выборка.Ссылка <> Ссылка
            И ВРег(СокрЛП(Выборка.Наименование)) = ИскомоеИмя Тогда
            ВызватьИсключение "Марка автомобиля с таким наименованием уже существует.";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры