Процедура ПередЗаписью(Отказ)
    Наименование = СокрЛП(Наименование);
    Если ПустаяСтрока(Наименование) Тогда
        ВызватьИсключение "Укажите наименование модели автомобиля.";
    КонецЕсли;
    Если Марка.Пустая() Тогда
        ВызватьИсключение "Выберите марку автомобиля для модели.";
    КонецЕсли;

    // Одинаковая модель допустима у разных марок, но не у одной марки.
    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ
        |   Модели.Ссылка КАК Ссылка,
        |   Модели.Наименование КАК Наименование
        |ИЗ
        |   Справочник.МоделиАвтомобилей КАК Модели
        |ГДЕ
        |   Модели.Марка = &Марка";
    Запрос.УстановитьПараметр("Марка", Марка);

    Выборка = Запрос.Выполнить().Выбрать();
    ИскомоеИмя = ВРег(Наименование);
    Пока Выборка.Следующий() Цикл
        Если Выборка.Ссылка <> Ссылка
            И ВРег(СокрЛП(Выборка.Наименование)) = ИскомоеИмя Тогда
            ВызватьИсключение "У выбранной марки такая модель уже существует.";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры
