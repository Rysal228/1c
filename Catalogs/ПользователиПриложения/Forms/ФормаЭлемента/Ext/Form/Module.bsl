
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Если Объект.Ссылка.Пустая() Тогда
        Объект.Активен = Истина;
        РольПользователь = Истина;
        Возврат;
    КонецЕсли;

    Набор = РегистрыСведений.РолиПользователей.СоздатьНаборЗаписей();
    Набор.Отбор.Пользователь.Установить(Объект.Ссылка);
    Набор.Прочитать();

    Для Каждого СтрокаРегистра Из Набор Цикл
        Если СтрокаРегистра.Роль = Перечисления.РолиПользователей.Пользователь Тогда
            РольПользователь = Истина;
        ИначеЕсли СтрокаРегистра.Роль = Перечисления.РолиПользователей.Специалист Тогда
            РольСпециалист = Истина;
        ИначеЕсли СтрокаРегистра.Роль = Перечисления.РолиПользователей.Менеджер Тогда
            РольМенеджер = Истина;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура СохранитьПользователяНаСервере(ЗадаватьПароль)
    Если НЕ РольПользователь И НЕ РольСпециалист И НЕ РольМенеджер Тогда
        ВызватьИсключение "Назначьте пользователю хотя бы одну роль.";
    КонецЕсли;

    Если ЗадаватьПароль Тогда
        Если НовыйПароль <> ПовторПароля Тогда
            ВызватьИсключение "Новый пароль и подтверждение не совпадают.";
        КонецЕсли;
        Если СтрДлина(НовыйПароль) < 8 Или СтрДлина(НовыйПароль) > 128 Тогда
            ВызватьИсключение "Пароль должен содержать от 8 до 128 символов.";
        КонецЕсли;
    КонецЕсли;

    НачатьТранзакцию();
    Попытка
        ЭлементСправочника = РеквизитФормыВЗначение("Объект");
        Если ЗадаватьПароль И НЕ ЭлементСправочника.Активен Тогда
            ВызватьИсключение "Нельзя задавать пароль неактивному пользователю.";
        КонецЕсли;
        ЭлементСправочника.Записать();
        Ссылка = ЭлементСправочника.Ссылка;

        Роли = РегистрыСведений.РолиПользователей.СоздатьНаборЗаписей();
        Роли.Отбор.Пользователь.Установить(Ссылка);
        Роли.Прочитать();
        Роли.Очистить();

        Если РольПользователь Тогда
            ЗаписьРоли = Роли.Добавить();
            ЗаписьРоли.Пользователь = Ссылка;
            ЗаписьРоли.Роль = Перечисления.РолиПользователей.Пользователь;
        КонецЕсли;
        Если РольСпециалист Тогда
            ЗаписьРоли = Роли.Добавить();
            ЗаписьРоли.Пользователь = Ссылка;
            ЗаписьРоли.Роль = Перечисления.РолиПользователей.Специалист;
        КонецЕсли;
        Если РольМенеджер Тогда
            ЗаписьРоли = Роли.Добавить();
            ЗаписьРоли.Пользователь = Ссылка;
            ЗаписьРоли.Роль = Перечисления.РолиПользователей.Менеджер;
        КонецЕсли;
        Роли.Записать(Истина);

        Если ЗадаватьПароль Тогда
            Хеш = ВычислитьСохраняемоеЗначениеПароляПользователя(НовыйПароль);
            Если ТипЗнч(Хеш) <> Тип("Строка")
                Или ПустаяСтрока(Хеш)
                Или СтрДлина(Хеш) > 1024 Тогда
                ВызватьИсключение "Не удалось сформировать сохраняемое значение пароля.";
            КонецЕсли;

            Пароли = РегистрыСведений.ПаролиПользователейПриложения.СоздатьНаборЗаписей();
            Пароли.Отбор.Пользователь.Установить(Ссылка);
            Пароли.Прочитать();
            Пароли.Очистить();
            ЗаписьПароля = Пароли.Добавить();
            ЗаписьПароля.Пользователь = Ссылка;
            ЗаписьПароля.СохраняемоеЗначение = Хеш;
            Пароли.Записать(Истина);
        КонецЕсли;

        ЗафиксироватьТранзакцию();
        ЗначениеВРеквизитФормы(ЭлементСправочника, "Объект");
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПользователяКоманда(Команда)
    Попытка
        СохранитьПользователяНаСервере(Ложь);
        НовыйПароль = "";
        ПовторПароля = "";
        Сообщить("Пользователь и роли сохранены.");
        Закрыть();
    Исключение
        НовыйПароль = "";
        ПовторПароля = "";
        Сообщить("Не удалось сохранить пользователя: "
            + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьСПаролемКоманда(Команда)
    Попытка
        СохранитьПользователяНаСервере(Истина);
        НовыйПароль = "";
        ПовторПароля = "";
        Сообщить("Пользователь, роли и пароль сохранены.");
        Закрыть();
    Исключение
        НовыйПароль = "";
        ПовторПароля = "";
        Сообщить("Не удалось сохранить пользователя и пароль: "
            + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
КонецПроцедуры