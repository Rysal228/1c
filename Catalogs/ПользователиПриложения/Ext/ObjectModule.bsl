// Обязательные инварианты пользователя должны проверяться при любой записи:
// из формы 1С:Предприятия и через HTTP-сервис (Объект.Записать()).
// Состояние профиля и уникальность проверяет именно 1С, а не Django.

Процедура ПроверитьУникальностьРеквизита(ИмяРеквизита, Значение, СообщениеОбОшибке)
    Если ПустаяСтрока(Значение) Тогда
        Возврат;
    КонецЕсли;

    НайденнаяСсылка = Справочники.ПользователиПриложения.НайтиПоРеквизиту(
        ИмяРеквизита, Значение);
    Если НЕ НайденнаяСсылка.Пустая() И НайденнаяСсылка <> Ссылка Тогда
        ВызватьИсключение СообщениеОбОшибке;
    КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
    // В информационной базе храним телефон в едином формате 7XXXXXXXXXX.
    // В форме разрешаем и вариант +7XXXXXXXXXX.
    Телефон = СокрЛП(Телефон);
    Если Лев(Телефон, 1) = "+" Тогда
        Телефон = Сред(Телефон, 2);
    КонецЕсли;

    Если СтрДлина(Телефон) <> 11 Или Лев(Телефон, 1) <> "7" Тогда
        ВызватьИсключение "Телефон должен быть в формате 7XXXXXXXXXX.";
    КонецЕсли;

    Для Позиция = 1 По 11 Цикл
        Если Найти("0123456789", Сред(Телефон, Позиция, 1)) = 0 Тогда
            ВызватьИсключение "Телефон должен содержать только цифры.";
        КонецЕсли;
    КонецЦикла;

    // Не выдумываем ФИО: профиль может быть незаполненным.
    Имя = СокрЛП(Имя);
    Фамилия = СокрЛП(Фамилия);
    Отчество = СокрЛП(Отчество);
    ИдентификаторMAX = СокрЛП(ИдентификаторMAX);
    ИдентификаторВнешний = СокрЛП(ИдентификаторВнешний);

    Если СтрДлина(Имя) > 150 Или СтрДлина(Фамилия) > 150
        Или СтрДлина(Отчество) > 150 Тогда
        ВызватьИсключение "Имя, фамилия и отчество не могут превышать 150 символов.";
    КонецЕсли;
    Если СтрДлина(ИдентификаторMAX) > 255
        Или СтрДлина(ИдентификаторВнешний) > 255 Тогда
        ВызватьИсключение "Идентификаторы пользователя не могут превышать 255 символов.";
    КонецЕсли;

    Если ЭтоНовый() Тогда
        // Код используется для уникальности и равен телефону при создании.
        Код = Телефон;
    Иначе
        // Изменение телефона / кода потребует отдельного контролируемого API.
        // Также запрещаем смену UUID существующего пользователя.
        ИсходныйОбъект = Ссылка.ПолучитьОбъект();
        Если ИсходныйОбъект.Телефон <> Телефон Тогда
            ВызватьИсключение "Телефон существующего пользователя нельзя изменять напрямую.";
        КонецЕсли;
        Если ИсходныйОбъект.Код <> Код Тогда
            ВызватьИсключение "Код существующего пользователя нельзя изменять напрямую.";
        КонецЕсли;
        Если НЕ ПустаяСтрока(ИсходныйОбъект.ИдентификаторВнешний)
            И ИсходныйОбъект.ИдентификаторВнешний <> ИдентификаторВнешний Тогда
            ВызватьИсключение "Идентификатор пользователя нельзя изменять.";
        КонецЕсли;
    КонецЕсли;

    // Новый пользователь, созданный непосредственно в 1С, получает свой UUID.
    // Для перенесённых пользователей сохраняется исходный UUID из Django.
    Если ПустаяСтрока(ИдентификаторВнешний) Тогда
        ИдентификаторВнешний = Строка(Новый УникальныйИдентификатор);
    КонецЕсли;

    // Уникальность кода дополнительно обеспечивается свойством справочника
    // CheckUnique. Проверяем реквизиты, в том числе старые элементы с другим кодом.
    ПроверитьУникальностьРеквизита("Телефон", Телефон,
        "Пользователь с таким телефоном уже существует.");
    ПроверитьУникальностьРеквизита("ИдентификаторВнешний", ИдентификаторВнешний,
        "Идентификатор закреплён за другим пользователем.");
    ПроверитьУникальностьРеквизита("ИдентификаторMAX", ИдентификаторMAX,
        "Аккаунт MAX уже закреплён за другим пользователем.");

    Наименование = СокрЛП(Фамилия + " " + Имя);
    Если ПустаяСтрока(Наименование) Тогда
        Наименование = Телефон;
    КонецЕсли;
КонецПроцедуры
