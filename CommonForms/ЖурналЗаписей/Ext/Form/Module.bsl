&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    ДатаПросмотра = НачалоДня(ТекущаяДата());

    Планировщик.ЕдиницаПериодическогоВарианта =
        ТипЕдиницыШкалыВремени.Час;

    Планировщик.КратностьПериодическогоВарианта = 24;

    // Рабочая область: с 08:00 до 21:00.
    Планировщик.ОтступСНачалаПереносаШкалыВремени = 8;
    Планировщик.ОтступСКонцаПереносаШкалыВремени = 3;

    Планировщик.ВыравниватьГраницыЭлементовПоШкалеВремени = Ложь;

    Планировщик.ОтображатьПеренесенныеЗаголовки = Истина;

    ОбновитьЖурналНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОбновитьЖурналНаСервере()

    НачалоПериода = НачалоДня(ДатаПросмотра);
    КонецПериода = НачалоПериода + 7 * 86400;

    Планировщик.Элементы.Очистить();

    Планировщик.ТекущиеПериодыОтображения.Очистить();
    Планировщик.ТекущиеПериодыОтображения.Добавить(
        НачалоПериода,
        КонецПериода - 1
    );

    ЗапросНастроек = Новый Запрос;

    ЗапросНастроек.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |   Настройки.ДлительностьМинут КАК ДлительностьМинут
        |ИЗ
        |   РегистрСведений.НастройкиЗаписи КАК Настройки
        |ГДЕ
        |   Настройки.Ключ = &Ключ";

    ЗапросНастроек.УстановитьПараметр("Ключ", "main");

    ВыборкаНастроек = ЗапросНастроек.Выполнить().Выбрать();

    Если НЕ ВыборкаНастроек.Следующий() Тогда
        ВызватьИсключение
            "Не заполнены настройки записи с ключом main.";
    КонецЕсли;

    ДлительностьМинут = ВыборкаНастроек.ДлительностьМинут;

    // Получаем заказы на выбранную дату.
    Запрос = Новый Запрос;

    Запрос.Текст =
        "ВЫБРАТЬ
        |   Заказы.Ссылка КАК Ссылка,
        |   Заказы.ДатаЗаписи КАК ДатаЗаписи,
        |   Заказы.ФиоКлиентаСнимок КАК Клиент,
        |   Заказы.МаркаСнимок КАК Марка,
        |   Заказы.МодельСнимок КАК Модель,
        |   Заказы.ГосНомерСнимок КАК ГосНомер
        |ИЗ
        |   Документ.ЗаказыНаОбслуживание КАК Заказы
        |ГДЕ
        |   НЕ Заказы.ПометкаУдаления
        |   И Заказы.ДатаЗаписи >= &НачалоПериода
        |   И Заказы.ДатаЗаписи < &КонецПериода
        |УПОРЯДОЧИТЬ ПО
        |   ДатаЗаписи";

    Запрос.УстановитьПараметр(
        "НачалоПериода", НачалоПериода
    );

    Запрос.УстановитьПараметр(
        "КонецПериода", КонецПериода
    );

    Выборка = Запрос.Выполнить().Выбрать();

    Пока Выборка.Следующий() Цикл

        НачалоЗаписи = Выборка.ДатаЗаписи;

        КонецЗаписи = НачалоЗаписи
            + ДлительностьМинут * 60;

        // Создаём блок в планировщике.
        НовыйЭлемент = Планировщик.Элементы.Добавить(
            НачалоЗаписи,
            КонецЗаписи
        );

	НовыйЭлемент.Текст = Выборка.Клиент + " — " + Выборка.Марка + " " + Выборка.Модель; 
	НовыйЭлемент.Значение = Выборка.Ссылка;

    КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ДатаПросмотраПриИзменении(Элемент)
	ОбновитьЖурналНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПланировщикВыбор(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;

    Если Элемент.ВыделенныеЭлементы.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    СсылкаЗаказа =
        Элемент.ВыделенныеЭлементы[0].Значение;

    Если НЕ ЗначениеЗаполнено(СсылкаЗаказа) Тогда
        Возврат;
    КонецЕсли;

	ПараметрыФормы = Новый Структура(
        "Ключ", СсылкаЗаказа
    );

    ОткрытьФорму(
        "Документ.ЗаказыНаОбслуживание.ФормаОбъекта",
        ПараметрыФормы
    );КонецПроцедуры
